
public class GlamDocItemBoughtCallback extends InventoryScriptCallback {

  private let eventTarget: wref<GlamDocGameController>;

  public final func Bind(eventTargetArg: ref<GlamDocGameController>) -> Void {
    this.eventTarget = eventTargetArg;
  }

  public func OnItemAdded(itemIDArg: ItemID, itemData: wref<gameItemData>, flaggedAsSilent: Bool) -> Void {
    this.eventTarget.OnItemBought(itemIDArg, itemData);
  }
}

public class GlamdocAttachmentSlotsScriptCallback extends AttachmentSlotsScriptCallback {

  public let m_puppet: wref<gamePuppet>;

  public let m_player: wref<PlayerPuppet>;

  public let m_transactionSystem: wref<TransactionSystem>;

  public let m_slotToWaitFor: TweakDBID;

  public let m_slotToClear: TweakDBID;

  public let m_itemToWaitFor: ItemID;

  public let m_controller: wref<GlamDocGameController>;

  public let m_visualSlots: [TweakDBID];

  public let m_isUnequipping: Bool;

  public let m_timeToWaitWhenUnequipping: Float;

  public func OnItemEquippedVisual(slot: TweakDBID, item: ItemID) -> Void {
    this.ShowPuppetPreviewOnceItemsVisualsAreUpdated(slot, item);
  }

  public func OnItemUnequippedComplete(slot: TweakDBID, item: ItemID) -> Void {
    this.ShowPuppetPreviewOnceItemsVisualsAreUpdated(slot, item);
  }

  private final func ShowPuppetPreviewOnceItemsVisualsAreUpdated(slot: TweakDBID, item: ItemID) -> Void {
    let delayEvent: ref<VisualSlotsUpdatedEvent>;
    let armsCWVisualEquipped: ref<ArmsCWVisualEquipped> = new ArmsCWVisualEquipped();
    if this.m_slotToWaitFor == slot {
      if this.m_itemToWaitFor == item && !this.m_transactionSystem.IsSlotEmpty(this.m_puppet, this.m_slotToClear) {
        this.m_transactionSystem.RemoveItemFromSlot(this.m_puppet, this.m_slotToClear);
        GameInstance.GetUISystem(this.m_puppet.GetGame()).QueueEvent(armsCWVisualEquipped);
        this.m_controller.UpdatePuppetBasedOnCurrentScreen();
        ArrayPush(this.m_visualSlots, this.m_slotToClear);
      };
    };
    ArrayRemove(this.m_visualSlots, slot);
    if ArraySize(this.m_visualSlots) <= 0 {
      if this.m_isUnequipping {
        delayEvent = new VisualSlotsUpdatedEvent();
        GameInstance.GetDelaySystem(this.m_player.GetGame()).DelayEvent(this.m_player, delayEvent, this.m_timeToWaitWhenUnequipping, false);
      } else {
        this.m_controller.ShowPreviewPuppet();
      };
    };
  }
}

