public class MoreOptionsButtonController extends DropdownButtonController {

  private edit let m_arrowFill: inkImageRef;

  protected edit let m_buttonText: inkTextRef;

  protected edit let m_buttonIcon: inkImageRef;

  protected edit let m_buttonCore: inkWidgetRef;

  protected edit let m_buttonBorder: inkWidgetRef;

  private let m_ownerWidget: wref<ModDetailsItem>;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private let m_colorNames: ModsMenuColorsNames;

  private let m_isDisabled: Bool;

  protected cb func OnInitialize() -> Bool {
    this.m_isDisabled = false;
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.SetDefaultColor();
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
  }

  private final func SetDefaultColor() -> Void {
    inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.redName);
    inkWidgetRef.Get(this.m_arrow).BindProperty(n"tintColor", this.m_colorNames.redName);
    inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.fullscreenRedDarkBackgroundName);
    inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.darkerRedName);
  }

  private final func SetHoveredColor() -> Void {
    inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_arrow).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.fullscreenPrimaryBackgroundDarkName);
    inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.mildBlueName);
  }

  private final func SetDisabledColor() -> Void {
    inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.panelDarkGreyName);
    inkWidgetRef.Get(this.m_arrow).BindProperty(n"tintColor", this.m_colorNames.panelDarkGreyName);
    inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.panelDarkestGreyName);
    inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.panelDarkerGreyName);
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    if !this.m_isDisabled {
      this.SetHoveredColor();
    };
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    if !this.m_isDisabled {
      this.SetDefaultColor();
    } else {
      this.SetDisabledColor();
    };
  }

  protected cb func OnRelease(evt: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      this.m_ownerWidget.m_moreOptionsDropdownListController.Toggle();
    };
  }

  public final func SetIsDisabled(bInDisabled: Bool) -> Void {
    let bChanged: Bool = NotEquals(this.m_isDisabled, bInDisabled);
    this.m_isDisabled = bInDisabled;
    if this.m_isDisabled && bChanged {
      this.SetDisabledColor();
      this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    } else {
      if !this.m_isDisabled && bChanged {
        this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
        this.SetDefaultColor();
      };
    };
  }

  public final func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inMenu;
  }

  public final func SetOwnerWidget(inWidget: wref<ModDetailsItem>) -> Void {
    this.m_ownerWidget = inWidget;
  }
}

public class ModPanelDownloadProgressBarController extends LoadingScreenProgressBarController {

  protected edit let spinnerFluff: inkWidgetRef;

  protected edit let textFluff: inkWidgetRef;

  protected edit let progressText: inkTextRef;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
  }

  protected cb func OnUninitialize() -> Bool {
    super.OnUninitialize();
  }

  public final func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inMenu;
  }

  public final func SetGlobalVisibility(visible: Bool) -> Void {
    this.SetProgressBarVisiblity(visible);
    this.SetSpinnerVisibility(visible);
    inkWidgetRef.SetVisible(this.spinnerFluff, visible);
    inkWidgetRef.SetVisible(this.textFluff, visible);
    inkWidgetRef.SetVisible(this.progressText, visible);
  }

  public final func SetProgressTextFromProgress(state: inkModioModProgressState) -> Void {
    switch state {
      case inkModioModProgressState.Downloading:
        inkTextRef.SetText(this.progressText, GetLocalizedText("UI-Modio-MenuContent-Download"));
        break;
      case inkModioModProgressState.Extracting:
        inkTextRef.SetText(this.progressText, GetLocalizedText("UI-Modio-MenuContent-Extract"));
        break;
      case inkModioModProgressState.CleaningUp:
        inkTextRef.SetText(this.progressText, GetLocalizedText("UI-Modio-MenuContent-CleanUp"));
        break;
      default:
        inkTextRef.SetText(this.progressText, "");
    };
  }
}

public class ModItemDownloadProgressBarController extends LoadingScreenProgressBarController {

  protected edit let backgroundOpacity: inkWidgetRef;

  protected edit let progressText: inkTextRef;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
  }

  protected cb func OnUninitialize() -> Bool {
    super.OnUninitialize();
  }

  public final func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inMenu;
  }

  public final func SetGlobalVisibility(visible: Bool) -> Void {
    this.SetProgressBarVisiblity(visible);
    inkWidgetRef.SetVisible(this.backgroundOpacity, visible);
    inkWidgetRef.SetVisible(this.progressText, visible);
  }

  public final func SetProgressBarVisibility(visible: Bool) -> Void {
    this.SetProgressBarVisiblity(visible);
  }

  public final func SetProgressTextFromProgress(state: inkModioModProgressState) -> Void {
    switch state {
      case inkModioModProgressState.Downloading:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-Download"));
        break;
      case inkModioModProgressState.Extracting:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-Extract"));
        break;
      case inkModioModProgressState.CleaningUp:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-CleanUp"));
        break;
      default:
        inkTextRef.SetText(this.progressText, "");
    };
  }

  public final func SetProgressTextFromModState(state: inkModioModState) -> Void {
    switch state {
      case inkModioModState.InstallationPending:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-VerifModPendInstall"));
        break;
      case inkModioModState.Installed:
        inkTextRef.SetText(this.progressText, "");
        break;
      case inkModioModState.UpdatePending:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-VerifModPendUpdate"));
        break;
      case inkModioModState.Downloading:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-Download"));
        break;
      case inkModioModState.Extracting:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-Extract"));
        break;
      case inkModioModState.UninstallPending:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-PendUninstall"));
        break;
      case inkModioModState.Reconciling:
        inkTextRef.SetText(this.progressText, GetLocalizedTextByKey(n"UI-Modio-MenuContent-Reconciling"));
        break;
      default:
        inkTextRef.SetText(this.progressText, "");
    };
  }
}

public class PageSelectorItem extends inkButtonController {

  public edit let m_pageNumberText: inkTextRef;

  private edit let m_underlineIcon: inkWidgetRef;

  public let m_pageNumber: Int32;

  private let m_isSeparator: Bool;

  private let m_isSelected: Bool;

  private let m_isRegistered: Bool;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected cb func OnInitialize() -> Bool {
    this.SetUnselectedColor();
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.m_isRegistered = false;
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
  }

  public final func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inMenu;
  }

  public final func ShowPageItem(ownerMenu: ref<ModioBrowserMenuGameController>, pageNumber: Int32, currentlySelectedPageNumber: Int32) -> Void {
    this.SetPageNumber(pageNumber);
    if !this.m_isRegistered {
      this.RegisterToCallback(n"OnRelease", ownerMenu, n"OnPageClicked");
    };
    this.GetRootWidget().SetVisible(true);
    this.GetRootWidget().SetInteractive(true);
    this.m_ownerMenu.AddToListOfNavigables(this);
    this.SetNavigable(this.m_ownerMenu.GetIsNavigationActive());
    this.SetIsSelected(currentlySelectedPageNumber == pageNumber);
    this.m_isRegistered = true;
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    this.PlaySound(n"Button", n"OnHover");
    if !this.m_isSeparator && !this.m_ownerMenu.ShouldIgnoreInput() {
      inkWidgetRef.Get(this.m_pageNumberText).BindProperty(n"tintColor", n"MainColors.Blue");
    };
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    if !this.m_isSelected {
      inkWidgetRef.Get(this.m_pageNumberText).BindProperty(n"tintColor", n"MainColors.Red");
    };
  }

  public final func SetAsPageSeparator(ownerMenu: ref<ModioBrowserMenuGameController>) -> Void {
    this.SetPageNumber(0);
    inkTextRef.SetText(this.m_pageNumberText, "...");
    this.m_isSeparator = true;
    this.UnregisterFromCallback(n"OnRelease", ownerMenu, n"OnPageClicked");
    this.m_isRegistered = false;
    this.GetRootWidget().SetInteractive(false);
    this.m_ownerMenu.RemoveFromListOfNavigables(this);
    this.SetNavigable(false);
    this.GetRootWidget().SetVisible(true);
    this.SetUnselectedColor();
  }

  public final func HidePageItem(ownerMenu: ref<ModioBrowserMenuGameController>) -> Void {
    this.SetPageNumber(0);
    this.UnregisterFromCallback(n"OnRelease", ownerMenu, n"OnPageClicked");
    this.m_ownerMenu.RemoveFromListOfNavigables(this);
    this.m_isRegistered = false;
    this.GetRootWidget().SetVisible(false);
  }

  public final func SetPageNumber(pageNumber: Int32) -> Void {
    this.m_pageNumber = pageNumber;
    this.m_isSeparator = false;
    inkTextRef.SetText(this.m_pageNumberText, ToString(pageNumber));
  }

  public final func SetIsSelected(bSelected: Bool) -> Void {
    this.m_isSelected = bSelected;
    if bSelected {
      this.SetSelectedColor();
    } else {
      this.SetUnselectedColor();
    };
  }

  private final func SetUnselectedColor() -> Void {
    inkWidgetRef.Get(this.m_pageNumberText).BindProperty(n"tintColor", n"MainColors.Red");
    inkWidgetRef.Get(this.m_underlineIcon).BindProperty(n"tintColor", n"MainColors.Red");
  }

  private final func SetSelectedColor() -> Void {
    inkWidgetRef.Get(this.m_pageNumberText).BindProperty(n"tintColor", n"MainColors.Blue");
    inkWidgetRef.Get(this.m_underlineIcon).BindProperty(n"tintColor", n"MainColors.Blue");
  }
}

public class ModPaginationArrowController extends PaginationArrowController {

  private let m_bIsLeftArrow: Bool;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    this.RegisterToCallback(n"OnRelease", this, n"OnArrowClicked");
  }

  protected cb func OnUninitialize() -> Bool {
    super.OnUninitialize();
    this.UnregisterFromCallback(n"OnRelease", this, n"OnArrowClicked");
  }

  public final func InitializeModPaginationArrow(bInIsLeftArrow: Bool, inOwnerMenu: wref<BrowserModsMenuGameController>) -> Void {
    this.m_bIsLeftArrow = bInIsLeftArrow;
    this.m_ownerMenu = inOwnerMenu;
  }

  protected cb func OnArrowClicked(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    this.PlaySound(n"Button", n"OnPress");
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      if this.m_bIsLeftArrow {
        this.m_ownerMenu.GoToPreviousPage();
      } else {
        this.m_ownerMenu.GoToNextPage();
      };
    };
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    if !this.m_ownerMenu.ShouldIgnoreInput() {
      super.OnHoverOver(e);
    };
  }
}

public class ModioToolTipController extends AGenericTooltipController {

  private edit let m_TextToDisplay: inkTextRef;

  private edit let m_widthCanvas: inkWidgetRef;

  protected cb func OnInitialize() -> Bool {
