  private let m_modsearchBarController: wref<ModMenuSearchBarController>;

  private let m_downloadProgressBarController: wref<ModPanelDownloadProgressBarController>;

  private let m_PageSelectorItemWidgetList: [wref<inkWidget>];

  private let m_IgnoreNextEnableAction: Bool;

  private let m_IsInBrowserMenu: Bool;

  private let m_currentlySelectedModEntry: wref<ModEntryItem>;

  private let m_leftPageArrowController: wref<ModPaginationArrowController>;

  private let m_rightPageArrowController: wref<ModPaginationArrowController>;

