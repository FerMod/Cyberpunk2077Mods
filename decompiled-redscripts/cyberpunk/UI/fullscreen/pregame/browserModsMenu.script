  public edit let m_version: inkTextRef;

  public edit let m_changelog: inkTextRef;

  public edit let m_summary: inkTextRef;

  public edit let m_description: inkTextRef;

  public edit let m_subscriptionButton: inkWidgetRef;

  public edit let m_likeButton: inkWidgetRef;

  public edit let m_authorButton: inkWidgetRef;

