
public class BrowserModsMenuGameController extends ModioBrowserMenuGameController {

  private edit let m_BrowserMenuTitleText: inkWidgetRef;

  private edit let m_CollectionMenuTitleText: inkWidgetRef;

  private edit let m_buttonHintsManagerRef: inkWidgetRef;

  private edit let m_modPickerRef: inkWidgetRef;

  private edit let m_filterPickerRef: inkWidgetRef;

  private edit let m_modioBrowserHeaderTitle: inkTextRef;

  private edit let m_modioCollectionHeaderTitle: inkTextRef;

  private edit let m_modDetailsPanelSnapshot: inkWidgetRef;

  private edit let m_PageSelectorPanelRef: inkCompoundRef;

  private edit let m_modLimitNumberOfModsEnabledText: inkTextRef;

