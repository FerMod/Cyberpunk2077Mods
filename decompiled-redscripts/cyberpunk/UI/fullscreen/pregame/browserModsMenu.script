  protected cb func OnMenuUpdate(inNumberOfMods: Int32, inNumberOfEnabledMods: Int32) -> Bool {
    let maxNumberOfModsYouCanEnable: Int32;
    let textParamsForEnabledMods: ref<inkTextParams>;
    let textParamsForSpaceInfo: ref<inkTextParams>;
    inkTextRef.SetText(this.m_numberOfModsText, IntToString(inNumberOfMods) + " ");
    this.m_matureContentAndEnableAllModsCheckboxController.UpdateCheckbox();
    if this.IsNumberOfEnabledModLimited() {
      inkWidgetRef.SetVisible(this.m_modLimitNumberOfModsEnabledText, true);
      maxNumberOfModsYouCanEnable = this.GetEnableModLimitNumber();
      textParamsForEnabledMods = new inkTextParams();
      textParamsForEnabledMods.AddNumber("CURMODS", inNumberOfEnabledMods);
      textParamsForEnabledMods.AddNumber("MAXMODS", maxNumberOfModsYouCanEnable);
      inkTextRef.SetText(this.m_modLimitNumberOfModsEnabledText, GetLocalizedText("UI-Modio-MenuContent-NbrModsEnabled"), textParamsForEnabledMods);
    };
    textParamsForSpaceInfo = new inkTextParams();
    textParamsForSpaceInfo.AddString("STORAGELEFT", this.GetRemainingSpaceOnUserDiskText());
    textParamsForSpaceInfo.AddString("STORAGETOTAL", this.GetTotalSpaceOnUserDiskText());
    inkWidgetRef.SetVisible(this.m_spaceInfoTextRef, true);
    inkTextRef.SetText(this.m_spaceInfoTextRef, GetLocalizedText("UI-Modio-MenuContent-StorageInfo"), textParamsForSpaceInfo);
  }

