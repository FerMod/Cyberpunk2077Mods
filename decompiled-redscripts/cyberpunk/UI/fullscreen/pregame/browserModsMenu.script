public class GenericModButtonController extends AnimatedListItemController {

  protected edit let m_buttonText: inkTextRef;

  protected edit let m_buttonIcon: inkImageRef;

  protected edit let m_buttonCore: inkWidgetRef;

  protected edit let m_buttonBorder: inkWidgetRef;

  protected let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected let m_isForFunction: Bool;

  private let m_isSelected: Bool;

  private let m_colorNames: ModsMenuColorsNames;

  protected let m_isDisabled: Bool;

  protected let m_isHovered: Bool;

  protected cb func OnInitialize() -> Bool {
    this.m_isHovered = false;
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    super.OnInitialize();
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
    super.OnUninitialize();
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    this.m_isHovered = true;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    if !this.m_isDisabled {
      this.ApplyHoveredColor();
    };
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    this.m_isHovered = false;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    this.ApplyButtonColor(this.m_isSelected);
  }

  protected cb func OnRelease(e: ref<inkPointerEvent>) -> Bool {
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
    };
  }

  public func SetIsDisabled(bInDisabled: Bool) -> Bool {
    let bChanged: Bool = NotEquals(this.m_isDisabled, bInDisabled);
    this.m_isDisabled = bInDisabled;
    if this.m_isDisabled && bChanged {
      this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    } else {
      if !this.m_isDisabled && bChanged {
        this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
      };
    };
    return bChanged;
  }

  private final func ApplyHoveredColor() -> Void {
    inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_buttonIcon).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.fullscreenPrimaryBackgroundDarkName);
    inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.mildBlueName);
  }

  private final func ApplyButtonColor(bIsFunctionActivated: Bool) -> Void {
    if bIsFunctionActivated {
      inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
      inkWidgetRef.Get(this.m_buttonIcon).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
      inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.fullScreenSecondaryBackground3Name);
      inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
      this.m_isSelected = true;
    } else {
      inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
      inkWidgetRef.Get(this.m_buttonIcon).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
      inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.fullscreenRedDarkBackgroundName);
      inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.darkerRedName);
      this.m_isSelected = false;
    };
    if this.m_isDisabled {
      inkWidgetRef.Get(this.m_buttonText).BindProperty(n"tintColor", this.m_colorNames.panelDarkGreyName);
      inkWidgetRef.Get(this.m_buttonIcon).BindProperty(n"tintColor", this.m_colorNames.panelDarkGreyName);
      inkWidgetRef.Get(this.m_buttonCore).BindProperty(n"tintColor", this.m_colorNames.panelDarkestGreyName);
      inkWidgetRef.Get(this.m_buttonBorder).BindProperty(n"tintColor", this.m_colorNames.panelDarkerGreyName);
    } else {
      if this.m_isHovered {
        this.ApplyHoveredColor();
      };
    };
  }

  public final func SetGenericButtonInfo(bIsFunctionActivated: Bool) -> Void {
    this.ApplyButtonColor(bIsFunctionActivated);
  }

  public func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inMenu;
    this.m_ownerMenu.AddToListOfNavigables(this);
  }
}

public class SubscribeToModButtonController extends GenericModButtonController {

  private let m_isDeactivatedBecauseInPauseMenu: Bool;

  public func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    super.SetOwnerMenu(inMenu);
    this.m_isDeactivatedBecauseInPauseMenu = !this.m_ownerMenu.IsPregame();
  }

  protected cb func OnRelease(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    super.OnRelease(e);
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      if !this.m_isForFunction && this.m_ownerMenu.CanDisplayUninstallConfirmationPopup() {
        this.AskIfUserReallyWantToUnsubscribe();
      } else {
        this.m_ownerMenu.SubscribeToModButtonClicked(this.m_isForFunction);
      };
    };
  }

  protected cb func OnReleaseWhileInPauseMenu(e: ref<inkPointerEvent>) -> Bool {
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      this.m_ownerMenu.WarnAboutImpossibleActionInPauseMenu();
    };
  }

  private final func AskIfUserReallyWantToUnsubscribe() -> Void {
    this.m_ownerMenu.AskIfUserReallyWantToUnsubscribe();
  }

  public final func SetIsForSubscribe(bIsForSubscribe: Bool) -> Void {
    this.m_isForFunction = bIsForSubscribe;
  }

  public final func GetIsForSubscribe() -> Bool {
    return this.m_isForFunction;
  }

  public final func SetIsDisabledForOutOfSpaceReason(bNotEnoughSpace: Bool) -> Void {
    let bChangedState: Bool = this.SetIsDisabled(bNotEnoughSpace);
    if bNotEnoughSpace && bChangedState {
      this.RegisterToCallback(n"OnHoverOver", this.m_ownerMenu, n"OnDisabledForOutOfSpaceSubscribeHoverOver");
      this.RegisterToCallback(n"OnHoverOut", this.m_ownerMenu, n"OnDisabledForOutOfSpaceSubscribeHoverOut");
    } else {
      if !bNotEnoughSpace {
        this.UnregisterFromCallback(n"OnHoverOver", this.m_ownerMenu, n"OnDisabledForOutOfSpaceSubscribeHoverOver");
        this.UnregisterFromCallback(n"OnHoverOut", this.m_ownerMenu, n"OnDisabledForOutOfSpaceSubscribeHoverOut");
      };
    };
  }

  public final func SetIsDisabledForPauseMenuReason() -> Bool {
    let bChangedState: Bool = this.SetIsDisabled(true);
    if bChangedState {
      this.RegisterToCallback(n"OnRelease", this, n"OnReleaseWhileInPauseMenu");
    };
    return bChangedState;
  }

  public func SetIsDisabled(bInDisabled: Bool) -> Bool {
    if this.m_isDeactivatedBecauseInPauseMenu {
      return this.SetIsDisabledForPauseMenuReason();
    };
    return super.SetIsDisabled(bInDisabled);
  }

  public final func SetButtonInfo(bIsUserSubscribedToMod: Bool) -> Void {
    let subscribeButtonTextString: CName;
    this.SetGenericButtonInfo(bIsUserSubscribedToMod);
    this.SetIsForSubscribe(!bIsUserSubscribedToMod);
    subscribeButtonTextString = bIsUserSubscribedToMod ? n"UI-Modio-InputHints-Uninstall" : n"UI-Modio-MenuContent-Sub";
    inkTextRef.SetText(this.m_buttonText, GetLocalizedText(NameToString(subscribeButtonTextString)));
  }
}

