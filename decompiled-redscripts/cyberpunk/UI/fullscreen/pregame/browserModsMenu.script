  protected cb func OnHoldInput(e: ref<inkPointerEvent>) -> Bool {
    this.HandleHoldInput(e);
  }

  private final func HandleHoldInput(e: ref<inkPointerEvent>) -> Void {
    let holdProgress: Float;
    if this.ShouldIgnoreInput() {
      return;
    };
    if e.IsAction(n"enable_or_disable_all_mods") && !this.m_IsInBrowserMenu {
      holdProgress = e.GetHoldProgress();
      if holdProgress > 0.25 {
        this.m_IgnoreNextEnableAction = true;
      };
      if holdProgress < 1.00 {
        return;
      };
      this.PlaySound(n"Button", n"OnPress");
      this.EnableOrDisableAllMods();
    };
  }

  protected cb func OnSetMenuEventDispatcher(menuEventDispatcher: wref<inkMenuEventDispatcher>) -> Bool {
    this.m_eventDispatcher = menuEventDispatcher;
  }

  protected cb func OnButtonRelease(evt: ref<inkPointerEvent>) -> Bool {
    let widget: ref<inkWidget>;
    if this.IsFilterDrawerOpen() {
      if evt.IsAction(n"back") || evt.IsAction(n"display_filter_drawer") {
        this.HideFilterDrawer();
      } else {
        if evt.IsAction(n"focus_search_bar") {
          this.m_filterDrawer.ResetAll();
        } else {
          if evt.IsAction(n"navigate_up") {
            this.m_filterDrawer.NavigateUp();
          } else {
            if evt.IsAction(n"navigate_down") {
              this.m_filterDrawer.NavigateDown();
            };
          };
        };
      };
      return true;
    };
    if this.ShouldIgnoreInput() {
      return true;
    };
    if evt.IsAction(n"back") {
      if this.IsSearchBarFocused() {
        this.m_modsearchBarController.LoseFocus();
        evt.Handle();
      } else {
        if this.m_sortingDropdownListController.IsOpened() {
          this.m_sortingDropdownListController.Close();
          evt.Handle();
        } else {
          this.m_eventDispatcher.SpawnEvent(n"OnMainMenuBack");
          evt.Handle();
        };
      };
    } else {
      if evt.IsAction(n"mod_prior_menu") || evt.IsAction(n"mod_next_menu") {
        this.PlaySound(n"Button", n"OnPress");
        if !this.IsSearchBarFocused() {
          this.SwitchBetweenBrowserAndCollectionMenu();
          evt.Handle();
        };
      } else {
        if evt.IsAction(n"enable_or_disable_mod") {
          if !this.IsSearchBarFocused() && !this.m_waitingForNewModListState {
            if !this.m_IgnoreNextEnableAction && this.GetIsSelectedModInstalled() {
              this.PlaySound(n"Button", n"OnPress");
              this.EnableOrDisableCurrentlyFocusedMod();
            };
            this.m_IgnoreNextEnableAction = false;
            evt.Handle();
          };
        } else {
          if evt.IsAction(n"mod_prior_page") {
            if !this.IsSearchBarFocused() && !this.m_bIsInGallery && !this.m_waitingForNewModListState {
              this.PlaySound(n"Button", n"OnPress");
              this.GoToPreviousPage();
              evt.Handle();
            };
          } else {
            if evt.IsAction(n"mod_next_page") {
              if !this.IsSearchBarFocused() && !this.m_bIsInGallery && !this.m_waitingForNewModListState {
                this.PlaySound(n"Button", n"OnPress");
                this.GoToNextPage();
                evt.Handle();
              };
            } else {
              if evt.IsAction(n"click") || evt.IsAction(n"tap") && !evt.IsHandled() {
                widget = evt.GetCurrentTarget();
                if this.IsSearchBarFocused() && evt.GetCurrentTarget() != inkWidgetRef.Get(this.m_searchBarTextInput) {
                  this.m_modsearchBarController.LoseFocus();
                  widget.SetVisible(true);
                };
              } else {
                if evt.IsAction(n"subscribe_to_mod") {
                  if !this.IsSearchBarFocused() && !this.m_waitingForNewModListState {
                    this.PlaySound(n"Button", n"OnPress");
                    if this.IsPregame() {
                      if this.GetIsSelectedModInstalled() && this.CanDisplayUninstallConfirmationPopup() {
                        this.AskIfUserReallyWantToUnsubscribe();
                      } else {
                        this.SubscribeToModShortcutPressed();
                      };
                    } else {
                      this.WarnAboutImpossibleActionInPauseMenu();
                    };
                  };
                } else {
                  if evt.IsAction(n"focus_search_bar") && this.IsGameOnConsole() {
                    this.m_modsearchBarController.TryFocus(false);
                  } else {
                    if evt.IsAction(n"display_filter_drawer") {
                      if !this.IsSearchBarFocused() {
                        this.ShowFilterDrawer();
                      };
                    } else {
                      if evt.IsAction(n"display_hidden_mods") {
                        if !this.IsSearchBarFocused() {
                          this.DisplayHiddenModsPopup();
                        };
                      };
                    };
                  };
                };
              };
            };
          };
        };
      };
    };
  }

  public final func DisplayHiddenModsPopup() -> Void {
    let hiddenManagerEvent: ref<HiddenModManagerPopupEvent>;
    this.PlaySound(n"Button", n"OnPress");
    hiddenManagerEvent = new HiddenModManagerPopupEvent();
    hiddenManagerEvent.m_data = new HiddenModManagerPopupData();
    hiddenManagerEvent.m_data.queueName = n"modio_hiddenMods";
    hiddenManagerEvent.m_data.notificationName = n"base\\gameplay\\gui\\fullscreen\\main_menu\\modio\\modio_mutedmods.inkwidget";
    hiddenManagerEvent.m_data.isBlocking = true;
    hiddenManagerEvent.m_data.useCursor = true;
    hiddenManagerEvent.m_data.m_ownerMenu = this;
    hiddenManagerEvent.m_data.m_listOfHiddenMods = this.m_hiddenModsInfoList;
    hiddenManagerEvent.m_data.m_listOfModLogoPath = this.GetHiddenModsLogoPath();
    hiddenManagerEvent.m_data.m_listOfHiddenAuthors = this.GetHiddenAuthors();
    this.QueueBroadcastEvent(hiddenManagerEvent);
  }

