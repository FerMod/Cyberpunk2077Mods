  public final func DeactivateNavigation() -> Void {
    this.m_ownerMenu.DeactivateNavigation();
  }

  private final func RemoveEmptyDataState() -> Void {
    inkWidgetRef.SetVisible(this.m_emptyPreviewCanvas, false);
    inkWidgetRef.SetVisible(this.m_modDetailsContent, true);
  }

  public final func SetOwnerMenu(inOwnerMenu: wref<BrowserModsMenuGameController>) -> Void {
    let leftArrowNavController: ref<AnimatedListItemController>;
    let rightArrowNavController: ref<AnimatedListItemController>;
    this.m_ownerMenu = inOwnerMenu;
    let mainCarouselImageController: wref<ModioGalleryPreviewImageController> = inkWidgetRef.GetController(this.m_mainCarouselImageController) as ModioGalleryPreviewImageController;
    mainCarouselImageController.SetOwnerMenu(this.m_ownerMenu);
    leftArrowNavController = inkWidgetRef.GetControllerByType(this.m_leftCarouselArrow, n"AnimatedListItemController") as AnimatedListItemController;
    rightArrowNavController = inkWidgetRef.GetControllerByType(this.m_rightCarouselArrow, n"AnimatedListItemController") as AnimatedListItemController;
    this.m_ownerMenu.AddToListOfNavigables(leftArrowNavController);
    this.m_ownerMenu.AddToListOfNavigables(rightArrowNavController);
    this.m_ownerMenu.AddToListOfNavigables(this.m_enableDisableToggleNavController);
  }

  public final func InitializeModDetails(inModInfo: ModioModInfos, inSystemHandler: wref<inkISystemRequestsHandler>, inRemainingSpaceOnDisk: Uint64, inRemainingSpaceOnDiskFormattedText: String) -> Void {
    let bSupportedPlatform: Bool;
    let currentTag: wref<TagWidgetItem>;
    let i: Int32;
    let platformName: String;
    this.ResetCarouselState();
    this.m_systemHandler = inSystemHandler;
    if inModInfo.id != 0l {
      this.m_carouselSize = inModInfo.gallerySize;
      i = 0;
      while Cast<Int64>(i) < this.m_carouselSize {
        ArrayPush(this.m_carouselImagePaths, "");
        i += 1;
      };
      this.m_bIsModEnabled = inModInfo.bIsModEnabledForUser;
      inkTextRef.SetText(this.m_modName, inModInfo.name);
      inkTextRef.SetText(this.m_modAuthorName, inModInfo.authorName);
      platformName = GetPlatformShortName();
      bSupportedPlatform = Equals(platformName, "ps5") || Equals(platformName, "ps5pro") || Equals(platformName, "xseriesx") || Equals(platformName, "xseriess");
      if NotEquals(inModInfo.authorLinkedAccountName, "") && bSupportedPlatform {
        inkWidgetRef.SetVisible(this.m_modAuthorLinkedAccountName, true);
        inkWidgetRef.SetVisible(this.m_modPlatformSeparator, true);
        inkWidgetRef.SetVisible(this.m_platformText, true);
        inkTextRef.SetText(this.m_modAuthorLinkedAccountName, inModInfo.authorLinkedAccountName);
        if Equals(platformName, "ps5") || Equals(platformName, "ps5pro") {
          inkTextRef.SetText(this.m_platformText, GetLocalizedText("UI-Modio-MenuContent-CreatorIDPS5"));
        } else {
          if Equals(platformName, "xseriesx") || Equals(platformName, "xseriess") {
            inkTextRef.SetText(this.m_platformText, GetLocalizedText("UI-Modio-MenuContent-CreatorIDXbox"));
          };
        };
      } else {
        inkWidgetRef.SetVisible(this.m_modAuthorLinkedAccountName, false);
        inkWidgetRef.SetVisible(this.m_modPlatformSeparator, false);
        inkWidgetRef.SetVisible(this.m_platformText, false);
      };
      inkTextRef.SetText(this.m_summary, inModInfo.summary);
      inkTextRef.SetText(this.m_description, inModInfo.description);
      inkTextRef.SetText(this.m_changelog, inModInfo.changelog);
      inkTextRef.SetText(this.m_numberOfLikesText, ToString(inModInfo.rating));
      inkTextRef.SetText(this.m_modNumberOfDownloadsText, ToString(inModInfo.downloadsTotal));
      inkTextRef.SetText(this.m_modSizeText, this.m_ownerMenu.FormatByteSizeToReadableSize(inModInfo.size));
      this.m_isModTooBigToInstall = inModInfo.size > inRemainingSpaceOnDisk;
      inkWidgetRef.SetVisible(this.m_modTooBigIcon, this.ShouldPreventSubscribing(inModInfo.bIsUserSubscribedToMod));
      inkCompoundRef.RemoveAllChildren(this.m_tagsGridWidgetRef);
      ArrayClear(this.m_tagsItemArray);
      i = 0;
      while i < ArraySize(inModInfo.localizedTags) {
        currentTag = this.SpawnFromLocal(inkWidgetRef.Get(this.m_tagsGridWidgetRef), n"TagWidgetItem").GetController() as TagWidgetItem;
        currentTag.SetTagName(inModInfo.localizedTags[i]);
        ArrayPush(this.m_tagsItemArray, currentTag);
        i += 1;
      };
      this.m_scrollController.SetScrollPosition(0.00);
      this.UpdateEnableDisableToggleDisplay(this.m_ownerMenu.GetIsSelectedModInstalled(), inModInfo.bIsModEnabledForUser);
      this.SetupDropdown();
      this.ToggleMainCarouselImage(0);
      this.RemoveLoadingDataState();
    } else {
      this.SetEmptyDataState();
    };
    this.m_ownerMenu.RequestModDetailsUpdateNextFrame();
  }

  public final func SetScrollbarEnable(bEnable: Bool) -> Void {
    this.m_scrollController.SetEnabled(bEnable);
  }

  private final func UpdateEnableDisableToggleDisplay(bIsUserSubscribedToMod: Bool, bIsModEnabledForUser: Bool) -> Void {
    if this.m_enableDisableToggleAnimProxy != null {
      this.m_enableDisableToggleAnimProxy.GotoEndAndStop();
      this.m_enableDisableToggleAnimProxy.UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnEnableDisableToggleFinished");
      this.m_enableDisableToggleAnimProxy = null;
    };
    if bIsUserSubscribedToMod {
      inkWidgetRef.SetVisible(this.m_enableDisableToggleWidget, true);
      inkTextRef.SetText(this.m_enableDisableToggleText, GetLocalizedText(bIsModEnabledForUser ? "UI-Modio-MenuContent-Enabled" : "UI-Modio-MenuContent-Disabled"));
      this.PlayLibraryAnimation(bIsModEnabledForUser ? n"Toggle_On" : n"Toggle_Off");
    } else {
      inkWidgetRef.SetVisible(this.m_enableDisableToggleWidget, false);
    };
  }

  public final func PlayEnableDisableToggleTransitionAnimationIfNeeded(bModIsSubscribed: Bool, bFromDisableToEnable: Bool) -> Void {
    let animNameToPlay: CName;
    if !bModIsSubscribed {
      inkWidgetRef.SetVisible(this.m_enableDisableToggleWidget, false);
      if this.m_enableDisableToggleAnimProxy != null {
        this.m_enableDisableToggleAnimProxy.GotoEndAndStop();
        this.m_enableDisableToggleAnimProxy.UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnEnableDisableToggleFinished");
        this.m_enableDisableToggleAnimProxy = null;
      };
      return;
    };
    if NotEquals(this.m_bIsModEnabled, bFromDisableToEnable) {
      this.m_bIsModEnabled = bFromDisableToEnable;
      inkWidgetRef.SetVisible(this.m_enableDisableToggleWidget, true);
      animNameToPlay = bFromDisableToEnable ? n"Toggle_OfftoOn" : n"Toggle_OntoOff";
      inkTextRef.SetText(this.m_enableDisableToggleText, GetLocalizedText(bFromDisableToEnable ? "UI-Modio-MenuContent-Enabled" : "UI-Modio-MenuContent-Disabled"));
      if this.m_enableDisableToggleAnimProxy != null {
        this.m_enableDisableToggleAnimProxy.GotoEndAndStop();
        this.m_enableDisableToggleAnimProxy.UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnEnableDisableToggleFinished");
      };
      this.m_enableDisableToggleAnimProxy = this.PlayLibraryAnimation(animNameToPlay);
      this.m_enableDisableToggleAnimProxy.RegisterToCallback(inkanimEventType.OnFinish, this, n"OnEnableDisableToggleFinished");
    };
  }

  protected cb func OnEnableDisableToggleFinished(anim: ref<inkAnimProxy>) -> Bool {
    if this.m_enableDisableToggleAnimProxy != null {
      this.m_enableDisableToggleAnimProxy.UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnEnableDisableToggleFinished");
      this.m_enableDisableToggleAnimProxy = null;
      if this.m_isToggleHovered {
        this.m_ownerMenu.DisplayTooltipOnEnableDisableToggle(this.m_bIsModEnabled, inkWidgetRef.Get(this.m_enableDisableToggleWidget));
      };
    };
  }

  public final func EditPendingActivationOrDeactivationText(bIsModPendingActivationOrDeactivation: Bool, bIsModEnabled: Bool) -> Void {
    let textToDisplay: String;
    inkWidgetRef.SetVisible(this.m_pendingActivationOrDeactivationText, bIsModPendingActivationOrDeactivation);
    textToDisplay = bIsModEnabled ? GetLocalizedText("UI-Modio-ErrorMessages-WarningPendingActive") : GetLocalizedText("UI-Modio-ErrorMessages-WarningPendingDeactive");
    inkTextRef.SetText(this.m_pendingActivationOrDeactivationText, textToDisplay);
  }

  public final func AdjustCosmeticsForLikesAndDownloads(inModInfo: ModioModInfos) -> Void {
    let cosmeticNumberOfDownloads: Int64;
    let cosmeticNumberOfLikes: Int64;
    if inModInfo.id != 0l {
      cosmeticNumberOfLikes = inModInfo.rating + Cast<Int64>(inModInfo.bIsUserLikingMod ? 1 : 0);
      cosmeticNumberOfDownloads = inModInfo.downloadsTotal + this.m_ownerMenu.GetLocalNumberOfDownloadsForMod(inModInfo.id);
      inkTextRef.SetText(this.m_numberOfLikesText, ToString(cosmeticNumberOfLikes));
      inkTextRef.SetText(this.m_modNumberOfDownloadsText, ToString(cosmeticNumberOfDownloads));
    };
  }

  public final func SetTagWidgetCorrectSize() -> Void {
    let i: Int32 = 0;
    while i < ArraySize(this.m_tagsItemArray) {
      this.m_tagsItemArray[i].SetCorrectSize();
      i += 1;
    };
  }

  public final func SetCorrectTimestampInfo(inTimeStamp: Int32) -> Void {
    inkTextRef.SetText(this.m_lastUpdatedTimeText, "");
    inkTextRef.SetDateTimeByTimestamp(this.m_lastUpdatedTimeText, Cast<Uint64>(inTimeStamp));
  }

  public final func ShouldPreventSubscribing(bIsUserSubscribedToMod: Bool) -> Bool {
    return this.m_isModTooBigToInstall && !bIsUserSubscribedToMod;
  }

  public final func GetMoreOptionDropdownButtonController() -> ref<MoreOptionsButtonController> {
    return inkWidgetRef.GetController(this.m_moreOptionsDropdownButtonManagerRef) as MoreOptionsButtonController;
  }

  public final func GetMoreOptionNaviagableController() -> ref<inkDiscreteNavigationController> {
    return inkWidgetRef.GetControllerByType(this.m_moreOptionsDropdownButtonManagerRef, n"inkDiscreteNavigationController") as inkDiscreteNavigationController;
  }

  private final func SetupDropdown() -> Void {
    this.m_moreOptionsDropdownListController = inkWidgetRef.GetController(this.m_moreOptionsDropdownListManagerRef) as MoreOptionsDropdownListController;
    this.m_moreOptionsDropdownButtonController = inkWidgetRef.GetController(this.m_moreOptionsDropdownButtonManagerRef) as MoreOptionsButtonController;
    this.UpdateDropdownContext();
    this.m_moreOptionsDropdownButtonController.SetOwnerWidget(this);
  }

  private final func UpdateDropdownContext() -> Void {
    this.m_moreOptionsDropdownListController.Setup(this, MoreOptionsDropdownData.GetMoreOptionsDropdownOptions(), this.m_moreOptionsDropdownButtonController);
    this.m_moreOptionsDropdownButtonController.SetData(MoreOptionsDropdownData.GetMoreOptionsDropdownOption(this.m_moreOptionsDropdownListController.GetData(), inkModioMoreOptions.More));
  }

  protected cb func OnMoreOptionsButtonClicked(evt: ref<inkPointerEvent>) -> Bool {
    let controller: ref<DropdownListController>;
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      controller = this.m_moreOptionsDropdownListController.GetController() as DropdownListController;
      controller.Toggle();
    };
  }

  protected cb func OnDropdownItemClickedEvent(evt: ref<DropdownItemClickedEvent>) -> Bool {
    let moreOptionsButtonController: ref<DropdownButtonController>;
    let moreOptionsData: ref<DropdownItemData>;
    let moreOptionsIdentifier: inkModioMoreOptions;
    this.PlaySound(n"Button", n"OnPress");
    moreOptionsIdentifier = FromVariant<inkModioMoreOptions>(evt.identifier);
    moreOptionsData = MoreOptionsDropdownData.GetMoreOptionsDropdownOption((this.m_moreOptionsDropdownListController.GetController() as DropdownListController).GetData(), moreOptionsIdentifier);
    if IsDefined(moreOptionsData) {
      moreOptionsButtonController = this.m_moreOptionsDropdownListController.GetController() as DropdownButtonController;
      moreOptionsButtonController.SetData(moreOptionsData);
      this.ClickOnMoreOptionsButton(moreOptionsIdentifier);
    };
  }

  private final func ClickOnMoreOptionsButton(option: inkModioMoreOptions) -> Void {
    switch option {
      case inkModioMoreOptions.HideAuthor:
        this.AskIfReallyWantToMuteAuthor();
        break;
      case inkModioMoreOptions.HideMod:
        this.AskIfReallyWantToHideMod();
        break;
      case inkModioMoreOptions.Report:
        this.m_ownerMenu.OnReportClick();
    };
  }

  private final func AskIfReallyWantToHideMod() -> Void {
    this.m_systemHandler.RequestSystemNotificationGenericYesNo(n"UI-Modio-MenuContent-HideMod", n"UI-Modio-ErrorMessages-WarningHiddenMod", this, n"OnHideModConfirmationPopupClosed");
  }

  protected cb func OnHideModConfirmationPopupClosed(bAccepted: Bool) -> Bool {
    if bAccepted {
      this.m_ownerMenu.HideModButtonClicked();
    };
    if this.m_ownerMenu.IsUsingDPad() {
      this.m_ownerMenu.FocusMoreOptionButton();
    } else {
      this.m_ownerMenu.ResetCursor();
    };
    this.PlaySound(n"Button", n"OnPress");
  }

  private final func AskIfReallyWantToMuteAuthor() -> Void {
    this.m_systemHandler.RequestSystemNotificationGenericYesNo(n"UI-Modio-MenuContent-HideAuthor", n"UI-Modio-ErrorMessages-WarningHiddenAuthor", this, n"OnMuteAuthorConfirmationPopupClosed");
  }

  protected cb func OnMuteAuthorConfirmationPopupClosed(bAccepted: Bool) -> Bool {
    if bAccepted {
      this.m_ownerMenu.MuteAuthorButtonClicked();
    };
    if this.m_ownerMenu.IsUsingDPad() {
      this.m_ownerMenu.FocusMoreOptionButton();
    } else {
      this.m_ownerMenu.ResetCursor();
    };
    this.PlaySound(n"Button", n"OnPress");
  }

  public final func GetMainCarousselImageRef() -> ref<inkWidget> {
    return inkWidgetRef.Get(this.m_mainCarouselImage);
  }

  public final func ToggleMainCarouselImage(inNumberOfImagesExpected: Int32) -> Void {
    let bAtLeastOneImage: Bool = inNumberOfImagesExpected >= 1;
    let bAtLeastTwoImages: Bool = inNumberOfImagesExpected >= 2;
    let mainCarouselImageController: wref<ModioGalleryPreviewImageController> = inkWidgetRef.GetController(this.m_mainCarouselImageController) as ModioGalleryPreviewImageController;
    mainCarouselImageController.SetNavigable(bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_emptyMainCarouselImage, !bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_emptyLeftCarouselImage, !bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_emptyRightCarouselImage, !bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_leftCarouselArrow, bAtLeastTwoImages);
    inkWidgetRef.SetVisible(this.m_rightCarouselArrow, bAtLeastTwoImages);
    inkWidgetRef.SetVisible(this.m_mainCarouselImage, bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_leftCarouselImage, bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_rightCarouselImage, bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_carouselText, bAtLeastOneImage);
    inkWidgetRef.SetVisible(this.m_carouselTextShadow, bAtLeastOneImage);
    if bAtLeastOneImage {
      mainCarouselImageController.OverrideNavigation(inkDiscreteNavigationDirection.Down, this.m_ownerMenu.GetSubscribeToModButtonRef());
    };
  }

  private final func DisplayAllCarouselLoadingPanels() -> Void {
    inkWidgetRef.SetVisible(this.m_mainCarouselLoadingPanel, true);
    this.GetPrimaryImageWidget().SetVisible(false);
    inkWidgetRef.SetVisible(this.m_leftCarouselLoadingPanel, true);
    this.GetLeftImageWidget().SetVisible(false);
    inkWidgetRef.SetVisible(this.m_rightCarouselLoadingPanel, true);
    this.GetRightImageWidget().SetVisible(false);
  }

  public final func ReceiveNewGalleryIntent(inImageIndex: Int32) -> Void {
    if Cast<Int64>(inImageIndex) == this.m_currentCarouselIndex {
      inkWidgetRef.SetVisible(this.m_mainCarouselLoadingPanel, true);
      this.GetPrimaryImageWidget().SetVisible(false);
    } else {
      if Cast<Int64>(inImageIndex) == this.GetPreviousCarouselIndex() {
        inkWidgetRef.SetVisible(this.m_leftCarouselLoadingPanel, true);
        this.GetLeftImageWidget().SetVisible(false);
      } else {
        if Cast<Int64>(inImageIndex) == this.GetNextCarouselIndex() {
          inkWidgetRef.SetVisible(this.m_rightCarouselLoadingPanel, true);
          this.GetRightImageWidget().SetVisible(false);
        };
      };
    };
  }

  public final func ReceiveNewGalleryImage(inImageIndex: Int32, inImagePath: String) -> Void {
    this.m_carouselImagePaths[inImageIndex] = inImagePath;
    this.UpdateImages();
  }

  private final func UpdateImages() -> Void {
    this.ToggleMainCarouselImage(ArraySize(this.m_carouselImagePaths));
    this.DisplayAllCarouselLoadingPanels();
    this.m_numberOfScreenshotRequestsForMainImage = this.m_numberOfScreenshotRequestsForMainImage + 1;
    this.m_numberOfScreenshotRequestsForLeftImage = this.m_numberOfScreenshotRequestsForLeftImage + 1;
    this.m_numberOfScreenshotRequestsForRightImage = this.m_numberOfScreenshotRequestsForRightImage + 1;
    this.m_systemHandler.RequestGameScreenshotByPath(this.m_carouselImagePaths[Cast<Int32>(this.m_currentCarouselIndex)], this.GetPrimaryImageWidget(), this, n"OnScreenshotLoadedByPathOnCentralIndex");
    this.m_systemHandler.RequestGameScreenshotByPath(this.m_carouselImagePaths[Cast<Int32>(this.GetPreviousCarouselIndex())], this.GetLeftImageWidget(), this, n"OnScreenshotLoadedByPathOnLeftIndex");
    this.m_systemHandler.RequestGameScreenshotByPath(this.m_carouselImagePaths[Cast<Int32>(this.GetNextCarouselIndex())], this.GetRightImageWidget(), this, n"OnScreenshotLoadedByPathOnRightIndex");
    inkTextRef.SetText(this.m_carouselText, IntToString(Cast<Int32>(this.m_currentCarouselIndex) + 1) + "/" + IntToString(Cast<Int32>(this.m_carouselSize)));
    inkTextRef.SetText(this.m_carouselTextShadow, IntToString(Cast<Int32>(this.m_currentCarouselIndex) + 1) + "/" + IntToString(Cast<Int32>(this.m_carouselSize)));
  }

  public final func SetDefaultColor() -> Void {
    this.SetColor(this.m_colorNames.redName);
    this.SetPlatformInfoColor(this.m_colorNames.mildRedName);
  }

  public final func SetSubscribedColor() -> Void {
    this.SetColor(this.m_colorNames.yellowName);
    this.SetPlatformInfoColor(this.m_colorNames.mildYellowName);
  }

  public final func SetDisabledColor() -> Void {
    this.SetColor(this.m_colorNames.greyName);
    this.SetPlatformInfoColor(this.m_colorNames.darkerGreyName);
  }

  private final func SetColor(colorName: CName) -> Void {
    inkWidgetRef.Get(this.m_modAuthorName).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_numberOfLikesText).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_numberOfLikesIcon).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modNumberOfDownloadsText).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modNumberOfDownloadsIcon).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modSizeText).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modSizeIcon).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_lastUpdatedTimeText).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_lastUpdatedTimeIcon).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modPlatformSeparator).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modAuthorLinkedAccountName).BindProperty(n"tintColor", colorName);
  }

  private final func SetPlatformInfoColor(colorName: CName) -> Void {
    inkWidgetRef.Get(this.m_modioIcon).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_modioText).BindProperty(n"tintColor", colorName);
    inkWidgetRef.Get(this.m_platformText).BindProperty(n"tintColor", colorName);
  }

  public final func ApplyCorrectColor(bIsUserSubscribedToMod: Bool, bIsModDisabled: Bool) -> Void {
    if !bIsUserSubscribedToMod {
      this.SetDefaultColor();
    } else {
      if bIsUserSubscribedToMod && !bIsModDisabled {
        this.SetSubscribedColor();
      } else {
        if bIsUserSubscribedToMod && bIsModDisabled {
          this.SetDisabledColor();
        };
      };
    };
  }

  public final func GetPrimaryImageWidget() -> ref<inkImage> {
    return inkWidgetRef.Get(this.m_mainCarouselImage) as inkImage;
  }

  public final func GetLeftImageWidget() -> ref<inkImage> {
    return inkWidgetRef.Get(this.m_leftCarouselImage) as inkImage;
  }

  public final func GetRightImageWidget() -> ref<inkImage> {
    return inkWidgetRef.Get(this.m_rightCarouselImage) as inkImage;
  }

  public final func GetCarouselCurrentIndex() -> Int64 {
    return this.m_currentCarouselIndex;
  }

  public final func GetCarouselSize() -> Int64 {
    return this.m_carouselSize;
  }

  public final func GetCarouselImagePaths() -> [String] {
    return this.m_carouselImagePaths;
  }

  public final func ResetCarouselState() -> Void {
    this.m_currentCarouselIndex = 0l;
    ArrayClear(this.m_carouselImagePaths);
    inkWidgetRef.SetVisible(this.m_loadingFailedPanelWidget, false);
  }

  private final func GetPreviousCarouselIndex() -> Int64 {
    return this.m_currentCarouselIndex - 1l < 0l ? this.m_carouselSize - 1l : this.m_currentCarouselIndex - 1l;
  }

  private final func GetNextCarouselIndex() -> Int64 {
    return Cast<Int64>(this.m_currentCarouselIndex + 1l >= this.m_carouselSize ? 0 : Cast<Int32>(this.m_currentCarouselIndex + 1l));
  }

  public final func DisplayPreviousCarouselImage() -> Void {
    this.m_currentCarouselIndex = this.GetPreviousCarouselIndex();
    this.UpdateImages();
  }

  public final func DisplayNextCarouselImage() -> Void {
    this.m_currentCarouselIndex = this.GetNextCarouselIndex();
    this.UpdateImages();
  }

  protected cb func OnScreenshotLoadedByPathOnCentralIndex(screenshotSize: Vector2, errorCode: Int32) -> Bool {
    this.m_numberOfScreenshotRequestsForMainImage = this.m_numberOfScreenshotRequestsForMainImage > 0 ? this.m_numberOfScreenshotRequestsForMainImage - 1 : 0;
    if errorCode == 0 && this.m_numberOfScreenshotRequestsForMainImage == 0 {
      inkWidgetRef.SetVisible(this.m_mainCarouselLoadingPanel, false);
      inkWidgetRef.SetVisible(this.m_loadingFailedPanelWidget, false);
      if ArraySize(this.m_carouselImagePaths) > 0 {
        this.GetPrimaryImageWidget().SetVisible(true);
      } else {
        inkWidgetRef.SetVisible(this.m_emptyMainCarouselImage, true);
      };
    } else {
      if errorCode != 0 && this.m_numberOfScreenshotRequestsForMainImage == 0 {
        inkWidgetRef.SetVisible(this.m_mainCarouselLoadingPanel, false);
        inkWidgetRef.SetVisible(this.m_loadingFailedPanelWidget, true);
      };
    };
  }

  protected cb func OnScreenshotLoadedByPathOnLeftIndex(screenshotSize: Vector2, errorCode: Int32) -> Bool {
    this.m_numberOfScreenshotRequestsForLeftImage = this.m_numberOfScreenshotRequestsForLeftImage > 0 ? this.m_numberOfScreenshotRequestsForLeftImage - 1 : 0;
    if errorCode == 0 && this.m_numberOfScreenshotRequestsForLeftImage == 0 {
      inkWidgetRef.SetVisible(this.m_leftCarouselLoadingPanel, false);
      if ArraySize(this.m_carouselImagePaths) > 0 {
        this.GetLeftImageWidget().SetVisible(true);
      } else {
        inkWidgetRef.SetVisible(this.m_emptyLeftCarouselImage, true);
      };
    } else {
      if errorCode != 0 && this.m_numberOfScreenshotRequestsForLeftImage == 0 {
        inkWidgetRef.SetVisible(this.m_leftCarouselLoadingPanel, false);
        inkWidgetRef.SetVisible(this.m_emptyLeftCarouselImage, true);
      };
    };
  }

  protected cb func OnScreenshotLoadedByPathOnRightIndex(screenshotSize: Vector2, errorCode: Int32) -> Bool {
    this.m_numberOfScreenshotRequestsForRightImage = this.m_numberOfScreenshotRequestsForRightImage > 0 ? this.m_numberOfScreenshotRequestsForRightImage - 1 : 0;
    if errorCode == 0 && this.m_numberOfScreenshotRequestsForRightImage == 0 {
      inkWidgetRef.SetVisible(this.m_rightCarouselLoadingPanel, false);
      if ArraySize(this.m_carouselImagePaths) > 0 {
        this.GetRightImageWidget().SetVisible(true);
      } else {
        inkWidgetRef.SetVisible(this.m_emptyRightCarouselImage, true);
      };
    } else {
      if errorCode != 0 && this.m_numberOfScreenshotRequestsForRightImage == 0 {
        inkWidgetRef.SetVisible(this.m_rightCarouselLoadingPanel, false);
        inkWidgetRef.SetVisible(this.m_emptyRightCarouselImage, true);
      };
    };
  }
}

public class CarouselArrowController extends PaginationArrowController {

