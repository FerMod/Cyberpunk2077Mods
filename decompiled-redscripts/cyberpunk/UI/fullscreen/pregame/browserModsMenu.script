  }

  public final func SetTooltip(tooltipText: String) -> Void {
    inkTextRef.SetText(this.m_TextToDisplay, tooltipText);
  }
}

public class ModSortingDropdownElementController extends DropdownElementController {

  private edit let m_frameWidget: inkWidgetRef;

  private edit let m_background: inkWidgetRef;

  public let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private let m_colorNames: ModsMenuColorsNames;

  protected cb func OnInitialize() -> Bool {
    this.RegisterToCallback(n"OnStateChanged", this, n"OnNewState");
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnStateChanged", this, n"OnNewState");
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
  }

  protected cb func OnNewState(widget: wref<inkWidget>, oldState: CName, newState: CName) -> Bool {
    if Equals(newState, n"Active") {
      inkWidgetRef.Get(this.m_text).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
      inkWidgetRef.Get(this.m_background).BindProperty(n"tintColor", this.m_colorNames.supBlueName);
    } else {
      inkWidgetRef.Get(this.m_text).BindProperty(n"tintColor", this.m_colorNames.redName);
      inkWidgetRef.Get(this.m_background).BindProperty(n"tintColor", this.m_colorNames.sortBackgroundColor);
    };
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    let bIsLanguageDropdownOpened: Bool;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    this.PlaySound(n"Button", n"OnHover");
    inkWidgetRef.Get(this.m_frameWidget).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_frameWidget).BindProperty(n"opacity", n"Panel.frameOpacity");
    bIsLanguageDropdownOpened = this.m_ownerMenu.m_languageDropdownListController.IsOpened();
    if !bIsLanguageDropdownOpened {
      super.OnHoverOver(e);
    };
    inkWidgetRef.Get(this.m_text).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    let bIsLanguageDropdownOpened: Bool;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    inkWidgetRef.Get(this.m_frameWidget).BindProperty(n"tintColor", this.m_colorNames.frameColor);
    inkWidgetRef.Get(this.m_frameWidget).BindProperty(n"opacity", n"SortButton.frameOpacity");
    bIsLanguageDropdownOpened = this.m_ownerMenu.m_languageDropdownListController.IsOpened();
    if !bIsLanguageDropdownOpened {
      super.OnHoverOut(e);
    };
    if this.m_active {
      inkWidgetRef.Get(this.m_text).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    } else {
      inkWidgetRef.Get(this.m_text).BindProperty(n"tintColor", this.m_colorNames.redName);
    };
  }
}

public class ModSortingDropdownListController extends DropdownListController {

  private let m_owningMenu: wref<BrowserModsMenuGameController>;

  protected func SetupData(const data: script_ref<[ref<DropdownItemData>]>) -> Void {
    let i: Int32;
    let item: ref<ModSortingDropdownElementController>;
    this.m_data = Deref(data);
    inkCompoundRef.RemoveAllChildren(this.m_listContainer);
    i = 0;
    while i < ArraySize(Deref(data)) {
      item = this.SpawnFromLocal(inkWidgetRef.Get(this.m_listContainer), n"SortingDropdownElement").GetController() as ModSortingDropdownElementController;
      item.RegisterToCallback(n"OnRelease", this, n"OnDropdownItemClicked");
      item.m_ownerMenu = this.m_ownerController as BrowserModsMenuGameController;
      item.Setup(Deref(data)[i]);
      if i == 0 {
        item.SetActive(true);
        this.m_activeElement = item;
      };
      i += 1;
    };
  }

  public final func SetOwnerMenu(inMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_owningMenu = inMenu;
  }

  public func Close() -> Void {
    super.Close();
    this.m_owningMenu.ActivateNavigables();
  }

  public func Open() -> Void {
    super.Open();
    this.m_owningMenu.DeactivateNavigables();
  }
}

public abstract final class ModSortingDropdownData extends IScriptable {

  public final static func GetSortingDropdownOption(const options: script_ref<[ref<DropdownItemData>]>, identifier: inkModioModSortingOptions) -> ref<DropdownItemData> {
    let i: Int32 = 0;
    while i < ArraySize(Deref(options)) {
      if Equals(FromVariant<inkModioModSortingOptions>(Deref(options)[i].identifier), identifier) {
        return Deref(options)[i];
      };
      i += 1;
    };
    return null;
  }

  private final static func GetDropdownItemData(identifier: Variant, labelKey: CName, direction: DropdownItemDirection) -> ref<DropdownItemData> {
    let itemData: ref<DropdownItemData> = new DropdownItemData();
    itemData.identifier = identifier;
    itemData.labelKey = labelKey;
    itemData.direction = direction;
    return itemData;
  }

  public final static func GetSortingDropdownOptions() -> [ref<DropdownItemData>] {
    let result: array<ref<DropdownItemData>>;
    ArrayPush(result, ModSortingDropdownData.GetDropdownItemData(ToVariant(inkModioModSortingOptions.Trending), n"UI-Modio-FiltersSorting-Trending", DropdownItemDirection.None));
    ArrayPush(result, ModSortingDropdownData.GetDropdownItemData(ToVariant(inkModioModSortingOptions.Popular), n"UI-Modio-FiltersSorting-Popular", DropdownItemDirection.None));
    ArrayPush(result, ModSortingDropdownData.GetDropdownItemData(ToVariant(inkModioModSortingOptions.HighestRated), n"UI-Modio-FiltersSorting-HighRate", DropdownItemDirection.None));
    ArrayPush(result, ModSortingDropdownData.GetDropdownItemData(ToVariant(inkModioModSortingOptions.RecentlyUpdated), n"UI-Modio-FiltersSorting-RecentUpdate", DropdownItemDirection.None));
    ArrayPush(result, ModSortingDropdownData.GetDropdownItemData(ToVariant(inkModioModSortingOptions.RecentlyUploaded), n"UI-Modio-FiltersSorting-New", DropdownItemDirection.None));
    return result;
  }
}

