  private final func CreateModDetailsPanel() -> Void {
    let moreButtonNavigableController: ref<inkDiscreteNavigationController>;
    let modDetailsItemRef: ref<inkWidget> = this.SpawnFromLocal(inkWidgetRef.Get(this.m_modDetailsPanelSnapshot), n"ModDetailsItem");
    this.m_modDetailItem = modDetailsItemRef.GetController() as ModDetailsItem;
    this.m_subscribeToModController = inkWidgetRef.GetControllerByType(this.m_modDetailItem.m_subscriptionButton, n"SubscribeToModButtonController") as SubscribeToModButtonController;
    this.m_modDetailItem.SetOwnerMenu(this);
    this.m_subscribeToModController.SetOwnerMenu(this);
    this.m_likeController = inkWidgetRef.GetController(this.m_modDetailItem.m_likeButton) as LikeButtonController;
    this.m_likeController.SetOwnerMenu(this);
    this.m_authorController = inkWidgetRef.GetControllerByType(this.m_modDetailItem.m_authorButton, n"FromAuthorButtonController") as FromAuthorButtonController;
    this.m_authorController.SetOwnerMenu(this);
    this.m_moreOptionsController = this.m_modDetailItem.GetMoreOptionDropdownButtonController();
    this.m_moreOptionsController.SetOwnerMenu(this);
    moreButtonNavigableController = this.m_modDetailItem.GetMoreOptionNaviagableController();
    this.AddToListOfNavigables(moreButtonNavigableController);
    this.m_downloadProgressBarController = inkWidgetRef.GetControllerByType(this.m_modDetailItem.m_downloadProgressBar, n"ModPanelDownloadProgressBarController") as ModPanelDownloadProgressBarController;
    this.m_downloadProgressBarController.SetOwnerMenu(this);
  }

  protected cb func OnUninitialize() -> Bool {
    let platformName: String;
    this.m_systemHandler.CancelGameScreenshotRequests();
    this.UnregisterFromGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    this.UnregisterFromGlobalInputCallback(n"OnPostOnHold", this, n"OnHoldInput");
    this.UnregisterFromCallback(n"OnMenuUpdate", this, n"OnMenuUpdate");
    this.UnregisterFromCallback(n"OnModDetailsUpdate", this, n"OnModDetailsUpdate");
    this.UnregisterFromCallback(n"OnSearchbarUpdate", this, n"OnSearchbarUpdate");
    this.UnregisterFromCallback(n"OnButtonHintsUpdateRequested", this, n"OnButtonHintsUpdateRequested");
    this.UnregisterFromCallback(n"OnNewModSelected", this, n"OnNewModSelected");
    this.UnregisterFromCallback(n"OnProcessedModProgressUpdate", this, n"OnProcessedModProgressUpdate");
    this.UnregisterFromCallback(n"OnListOfModsToDisplayUpdated", this, n"OnListOfModsToDisplayUpdated");
    this.UnregisterFromCallback(n"OnNumberOfPagesChanged", this, n"OnNumberOfPagesChanged");
    this.UnregisterFromCallback(n"OnSwitchBetweenBrowserAndCollectionMenu", this, n"OnSwitchBetweenBrowserAndCollectionMenu");
    this.UnregisterFromCallback(n"OnRequestLogoForWidget", this, n"OnRequestLogoForWidget");
    this.UnregisterFromCallback(n"OnRequestedGalleryOnServer", this, n"OnRequestedGalleryOnServer");
    this.UnregisterFromCallback(n"OnRequestGalleryForWidget", this, n"OnRequestGalleryForWidget");
    this.UnregisterFromCallback(n"OnUserIdResult", this, n"OnUserIdResult");
    this.UnregisterFromCallback(n"OnLogoDownloadRequested", this, n"OnLogoDownloadRequested");
    this.UnregisterFromCallback(n"OnAllLanguagesCheckboxClicked", this, n"OnAllLanguagesCheckboxClicked");
    this.UnregisterFromCallback(n"OnRateLimitedErrorReceived", this, n"OnRateLimitedErrorReceived");
    this.UnregisterFromCallback(n"OnRateLimitedErrorLifted", this, n"OnRateLimitedErrorLifted");
    this.UnregisterFromCallback(n"OnUpdateModVerificationPopupCount", this, n"OnUpdateModVerificationPopupCount");
    this.UnregisterFromCallback(n"OnModTagsReceived", this, n"OnModTagsReceived");
    this.UnregisterFromCallback(n"OnDelayedSpawnForFilters", this, n"OnDelayedSpawnForFilters");
    this.UnregisterFromCallback(n"OnDelayedSliderAdjustForDrawer", this, n"OnDelayedSliderAdjustForDrawer");
    this.UnregisterFromCallback(n"OnHiddenModListUpdated", this, n"OnHiddenModListUpdated");
    this.UnregisterFromCallback(n"OnAskedForNewModList", this, n"OnAskedForNewModList");
    this.m_modPickerController.DestroyGrid(this);
    this.m_sortingDropdownButtonController.UnregisterFromCallback(n"OnRelease", this, n"OnSortingButtonClicked");
    this.m_languageDropdownButtonController.UnregisterFromCallback(n"OnRelease", this, n"OnLanguageButtonClicked");
    inkWidgetRef.UnregisterFromCallback(this.m_searchBarTextInput, n"OnTextChanged", this, n"OnTextChanged");
    inkWidgetRef.UnregisterFromCallback(this.m_BrowserMenuTitleText, n"OnRelease", this, n"OnBrowserMenuTextClicked");
    inkWidgetRef.UnregisterFromCallback(this.m_CollectionMenuTitleText, n"OnRelease", this, n"OnCollectionMenuTextClicked");
    super.OnUninitialize();
    platformName = GetPlatformShortName();
    if Equals(platformName, "ps5") || Equals(platformName, "ps5pro") || Equals(platformName, "xseriesx") || Equals(platformName, "xseriess") || Equals(platformName, "emporium") {
      inkWidgetRef.UnregisterFromCallback(this.m_searchBarArea, n"OnPress", this, n"OnSearchBarPress");
      inkWidgetRef.UnregisterFromCallback(this.m_searchBarArea, n"OnHoverOut", this, n"OnSearchBarHoverOut");
    };
    if Equals(platformName, "mac") || Equals(platformName, "windows") || Equals(platformName, "windowsGDK") {
      inkWidgetRef.UnregisterFromCallback(this.m_searchBarArea, n"OnPress", this, n"OnSearchBarPress");
    };
  }

