    super.OnUninitialize();
    this.UnregisterFromCallback(n"OnRelease", this, n"OnArrowClicked");
  }

  public final func InitializeCarouselArrow(bInIsLeftArrow: Bool, inModDetailsItem: wref<ModDetailsItem>) -> Void {
    this.m_bIsLeftArrow = bInIsLeftArrow;
    this.m_modDetailsItem = inModDetailsItem;
  }

