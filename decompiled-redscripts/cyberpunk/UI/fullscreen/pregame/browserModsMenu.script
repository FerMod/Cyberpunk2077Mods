      };
      i += 1;
    };
    return null;
  }

  private final static func GetDropdownItemData(identifier: Variant, labelKey: CName, direction: DropdownItemDirection) -> ref<DropdownItemData> {
    let itemData: ref<DropdownItemData> = new DropdownItemData();
    itemData.identifier = identifier;
    itemData.labelKey = labelKey;
    itemData.direction = direction;
    return itemData;
  }

  public final static func GetMoreOptionsDropdownOptions() -> [ref<DropdownItemData>] {
    let result: array<ref<DropdownItemData>>;
    ArrayPush(result, MoreOptionsDropdownData.GetDropdownItemData(ToVariant(inkModioMoreOptions.More), n"UI-Modio-MenuContent-More", DropdownItemDirection.None));
    ArrayPush(result, MoreOptionsDropdownData.GetDropdownItemData(ToVariant(inkModioMoreOptions.HideAuthor), n"UI-Modio-MenuContent-HideAuthor", DropdownItemDirection.None));
    ArrayPush(result, MoreOptionsDropdownData.GetDropdownItemData(ToVariant(inkModioMoreOptions.HideMod), n"UI-Modio-MenuContent-HideMod", DropdownItemDirection.None));
    ArrayPush(result, MoreOptionsDropdownData.GetDropdownItemData(ToVariant(inkModioMoreOptions.Report), n"UI-Modio-MenuContent-Report", DropdownItemDirection.None));
    return result;
  }
}

public abstract class ContentCheckbox extends AnimatedListItemController {

  protected edit let m_checkboxCanvas: inkWidgetRef;

  protected edit let m_checkboxImage: inkImageRef;

  protected edit let m_checkboxText: inkTextRef;

  protected let m_bState: Bool;

  protected let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected let m_colorNames: ModsMenuColorsNames;

  protected cb func OnInitialize() -> Bool {
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    this.SetNavigable(true);
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return false;
    };
    inkWidgetRef.Get(this.m_checkboxImage).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.SetVisible(this.m_checkboxImage, true);
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    inkWidgetRef.Get(this.m_checkboxImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.SetVisible(this.m_checkboxImage, this.m_bState);
  }

  protected cb func OnRelease(e: ref<inkPointerEvent>) -> Bool {
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.OnClickContentCheckbox();
      this.PlaySound(n"Button", n"OnPress");
    };
  }

  protected func OnClickContentCheckbox() -> Void {
    this.m_bState = !this.m_bState;
    inkWidgetRef.SetVisible(this.m_checkboxImage, this.m_bState);
  }
}

