public class ModioGalleryPreviewImageController extends AnimatedListItemController {

  private let m_modDetailsItem: wref<ModDetailsItem>;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected cb func OnInitialize() -> Bool {
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
  }

  public final func Setup(inModDetailsItem: wref<ModDetailsItem>) -> Void {
    this.m_modDetailsItem = inModDetailsItem;
  }

  public final func SetOwnerMenu(inOwnerMenu: wref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inOwnerMenu;
    this.m_ownerMenu.AddToListOfNavigables(this);
  }

  protected cb func OnRelease(e: ref<inkPointerEvent>) -> Bool {
    let previewEvent: ref<ModioGalleryPreviewPopupEvent>;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return false;
    };
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      if this.m_modDetailsItem.GetCarouselSize() == 0l {
        return false;
      };
      this.PlaySound(n"Button", n"OnPress");
      previewEvent = new ModioGalleryPreviewPopupEvent();
      previewEvent.m_data = new ModioGalleryPreviewData();
      previewEvent.m_data.queueName = n"modio_gallery";
      previewEvent.m_data.notificationName = n"base\\gameplay\\gui\\fullscreen\\main_menu\\modio\\modio_gallery_fullpreview.inkwidget";
      previewEvent.m_data.isBlocking = true;
      previewEvent.m_data.useCursor = true;
      previewEvent.m_data.m_modDetailsItem = this.m_modDetailsItem;
      previewEvent.m_data.m_ownerMenu = this.m_ownerMenu;
      this.QueueBroadcastEvent(previewEvent);
      e.Handle();
    };
  }
}

public class ModioGalleryFullPreview extends GalleryFullPreview {

  private edit let m_leftGalleryArrow: inkWidgetRef;

  private edit let m_rightGalleryArrow: inkWidgetRef;

  private edit let m_galleryText: inkTextRef;

  private edit let m_galleryTextShadow: inkTextRef;

  private edit let m_menuNavigationRef: inkWidgetRef;

  private let m_currentGalleryIndex: Int64;

  private let m_gallerySize: Int64;

  private let m_firstOpening: Bool;

  private let m_menuNavigationController: wref<inkContainerNavigationController>;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private let m_widget: wref<inkWidget>;

  protected cb func OnInitialize() -> Bool {
    let leftGalleryArrow: wref<GalleryArrowController>;
    let rightGalleryArrow: wref<GalleryArrowController>;
    this.m_systemHandler = this.GetSystemRequestsHandler();
    this.m_widget = this.GetRootWidget();
    this.m_data = this.GetRootWidget().GetUserData(n"ModioGalleryPreviewData") as ModioGalleryPreviewData;
    let screenshotData: wref<ModioGalleryPreviewData> = this.m_data as ModioGalleryPreviewData;
    this.m_ownerMenu = screenshotData.m_ownerMenu;
    if IsDefined(this.m_ownerMenu) {
      this.m_ownerMenu.SetIsInGallery(true);
    };
    this.m_buttonHintsController = this.SpawnFromExternal(inkWidgetRef.Get(this.m_buttonHintsManagerRef), r"base\\gameplay\\gui\\common\\buttonhints.inkwidget", n"Root").GetController() as ButtonHints;
    this.m_buttonHintsController.AddButtonHint(n"back", GetLocalizedText("Common-Access-Close"));
    this.RegisterToGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    this.m_preloader = this.SpawnFromExternal(inkWidgetRef.Get(this.m_container), r"base\\gameplay\\gui\\common\\preloader\\preloader.inkwidget", n"Root") as inkCompoundWidget;
    this.m_preloader.SetAnchor(inkEAnchor.Fill);
    this.m_preloader.SetAnchorPoint(new Vector2(0.50, 0.50));
    this.m_preloader.GetWidgetByPathName(n"border").SetVisible(false);
    this.m_preloader.SetVisible(true);
    inkWidgetRef.SetVisible(this.m_screenshotContainer, false);
    this.m_currentGalleryIndex = screenshotData.m_modDetailsItem.GetCarouselCurrentIndex();
    this.m_gallerySize = screenshotData.m_modDetailsItem.GetCarouselSize();
    this.m_firstOpening = true;
    leftGalleryArrow = inkWidgetRef.GetController(this.m_leftGalleryArrow) as GalleryArrowController;
    leftGalleryArrow.InitializeGalleryArrow(true, this);
    rightGalleryArrow = inkWidgetRef.GetController(this.m_rightGalleryArrow) as GalleryArrowController;
    rightGalleryArrow.InitializeGalleryArrow(false, this);
    this.m_ownerMenu.AddToListOfNavigables(leftGalleryArrow);
    this.m_ownerMenu.AddToListOfNavigables(rightGalleryArrow);
    this.m_menuNavigationController = inkWidgetRef.GetControllerByType(this.m_menuNavigationRef, n"inkContainerNavigationController") as inkContainerNavigationController;
    this.m_menuNavigationController.OverrideNavigation(inkDiscreteNavigationDirection.Up, inkWidgetRef.Get(this.m_leftGalleryArrow));
    this.m_menuNavigationController.OverrideNavigation(inkDiscreteNavigationDirection.Left, inkWidgetRef.Get(this.m_leftGalleryArrow));
    this.m_menuNavigationController.OverrideNavigation(inkDiscreteNavigationDirection.Down, inkWidgetRef.Get(this.m_rightGalleryArrow));
    this.m_menuNavigationController.OverrideNavigation(inkDiscreteNavigationDirection.Right, inkWidgetRef.Get(this.m_rightGalleryArrow));
    this.LoadGalleryImage();
  }

  protected cb func OnUninitialize() -> Bool {
    if IsDefined(this.m_ownerMenu) {
      this.m_ownerMenu.SetIsInGallery(false);
    };
  }

  protected cb func OnButtonRelease(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"cancel") {
      this.PlaySound(n"Button", n"OnPress");
      this.m_data.token.TriggerCallback(null);
    } else {
      if evt.IsAction(n"prior_menu") {
        this.PlaySound(n"Button", n"OnPress");
        this.DisplayPreviousGalleryImage();
      } else {
        if evt.IsAction(n"next_menu") {
          this.PlaySound(n"Button", n"OnPress");
          this.DisplayNextGalleryImage();
        };
      };
    };
  }

  protected final func LoadGalleryImage() -> Void {
    let screenshotData: wref<ModioGalleryPreviewData> = this.m_data as ModioGalleryPreviewData;
    let imagePaths: array<String> = screenshotData.m_modDetailsItem.GetCarouselImagePaths();
    let path: String = imagePaths[Cast<Int32>(this.m_currentGalleryIndex)];
    this.m_systemHandler.RequestGameScreenshotByPath(path, this.GetPreviewImageWidget(), this, n"OnScreenshotLoaded");
    inkTextRef.SetText(this.m_galleryText, IntToString(Cast<Int32>(this.m_currentGalleryIndex) + 1) + "/" + IntToString(Cast<Int32>(this.m_gallerySize)));
    inkTextRef.SetText(this.m_galleryTextShadow, IntToString(Cast<Int32>(this.m_currentGalleryIndex) + 1) + "/" + IntToString(Cast<Int32>(this.m_gallerySize)));
  }

  private final func GetPreviousGalleryIndex() -> Int64 {
    return this.m_currentGalleryIndex - 1l < 0l ? this.m_gallerySize - 1l : this.m_currentGalleryIndex - 1l;
  }

  private final func GetNextGalleryIndex() -> Int64 {
    return Cast<Int64>(this.m_currentGalleryIndex + 1l >= this.m_gallerySize ? 0 : Cast<Int32>(this.m_currentGalleryIndex + 1l));
  }

  public final func DisplayPreviousGalleryImage() -> Void {
    this.m_currentGalleryIndex = this.GetPreviousGalleryIndex();
    this.LoadGalleryImage();
  }

  public final func DisplayNextGalleryImage() -> Void {
    this.m_currentGalleryIndex = this.GetNextGalleryIndex();
    this.LoadGalleryImage();
  }

  public final func OnScreenshotLoaded(screenshotSize: Vector2, errorCode: Int32) -> Void {
    GalleryUtils.FillScreenshotInPreview(screenshotSize, inkWidgetRef.GetSize(this.m_screenshotPreview));
    inkWidgetRef.SetTintColor(this.m_screenshotPreview, new HDRColor(0.73, 0.73, 0.73, 1.00));
    this.m_preloader.SetVisible(false);
    if this.m_firstOpening {
      this.PlayLibraryAnimation(n"intro");
      this.m_firstOpening = false;
    };
  }
}

public class GalleryArrowController extends AnimatedListItemController {

  private let m_bIsLeftArrow: Bool;

  private let m_modGalleryPreview: wref<ModioGalleryFullPreview>;

  protected cb func OnInitialize() -> Bool {
    super.OnInitialize();
    this.RegisterToCallback(n"OnRelease", this, n"OnArrowClicked");
  }

  protected cb func OnUninitialize() -> Bool {
    super.OnUninitialize();
    this.UnregisterFromCallback(n"OnRelease", this, n"OnArrowClicked");
  }

  public final func InitializeGalleryArrow(bInIsLeftArrow: Bool, inGallery: wref<ModioGalleryFullPreview>) -> Void {
    this.m_bIsLeftArrow = bInIsLeftArrow;
    this.m_modGalleryPreview = inGallery;
  }

  protected cb func OnArrowClicked(e: ref<inkPointerEvent>) -> Bool {
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      if this.m_bIsLeftArrow {
        this.m_modGalleryPreview.DisplayPreviousGalleryImage();
      } else {
        this.m_modGalleryPreview.DisplayNextGalleryImage();
      };
    };
  }
}

public class ModMenuSearchBarController extends inkLogicController {

  private edit let m_searchBarInput: inkTextInputRef;

  public edit let m_searchBarDefaultText: inkTextRef;

  public let m_isFocused: Bool;

  private let m_ignoreNextUnfocusCall: Bool;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  protected cb func OnInitialize() -> Bool {
    this.m_isFocused = false;
    this.m_ignoreNextUnfocusCall = false;
    inkTextRef.SetText(this.m_searchBarDefaultText, GetLocalizedText("UI-Modio-FiltersSorting-Search"));
    this.RegisterToCallback(n"OnRelease", this, n"OnSearchBarClicked");
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnRelease", this, n"OnSearchBarClicked");
  }

  protected cb func OnSearchBarClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.TryFocus(true);
    };
  }

  public final func SetOwnerMenu(owner: wref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = owner;
  }

  public final func TryFocus(bFocusFromClickEvent: Bool) -> Void {
    let platformName: String;
    if !this.m_isFocused {
      platformName = GetPlatformShortName();
      if NotEquals(platformName, "ps5") && NotEquals(platformName, "ps5pro") && NotEquals(platformName, "xseriesx") && NotEquals(platformName, "xseriess") && NotEquals(platformName, "emporium") {
        (inkWidgetRef.Get(this.m_searchBarInput) as inkTextInput).RequestFocus();
        this.m_isFocused = true;
        this.m_ignoreNextUnfocusCall = bFocusFromClickEvent;
      } else {
        this.m_ownerMenu.OpenIMEDialogIfNeeded();
      };
      inkWidgetRef.SetVisible(this.m_searchBarDefaultText, false);
      this.m_ownerMenu.UpdateButtonHints();
      this.PlaySound(n"Button", n"OnPress");
    };
  }

  public final func Reset() -> Void {
    this.m_isFocused = false;
    this.m_ignoreNextUnfocusCall = false;
    inkTextRef.SetText(this.m_searchBarDefaultText, GetLocalizedText("UI-Modio-FiltersSorting-Search"));
    inkWidgetRef.SetVisible(this.m_searchBarDefaultText, true);
  }

  public final func LoseFocus() -> Void {
    let textInput: ref<inkTextInput> = inkWidgetRef.Get(this.m_searchBarInput) as inkTextInput;
    if !this.m_ignoreNextUnfocusCall && this.m_isFocused {
      textInput.RequestUnfocus();
      this.m_isFocused = false;
      this.DisplayDefaultTextIfEmpty();
      this.m_ownerMenu.UpdateButtonHints();
      this.PlaySound(n"Button", n"OnPress");
    };
    this.m_ignoreNextUnfocusCall = false;
  }

  public final func DisplayDefaultTextIfEmpty() -> Void {
    let textInput: ref<inkTextInput> = inkWidgetRef.Get(this.m_searchBarInput) as inkTextInput;
    if StrLen(textInput.GetText()) == 0 {
      inkTextRef.SetText(this.m_searchBarDefaultText, GetLocalizedText("UI-Modio-FiltersSorting-Search"));
      inkWidgetRef.SetVisible(this.m_searchBarDefaultText, true);
    };
  }

  public final func UpdateSearchbarOffset() -> Void {
    let searchBarSize: Vector2 = inkWidgetRef.GetSize(this.m_searchBarInput);
    let textSize: Vector2 = inkWidgetRef.GetDesiredSize(this.m_searchBarDefaultText);
    let offset: Float = searchBarSize.X - textSize.X;
    if offset < 0.00 {
      (inkWidgetRef.Get(this.m_searchBarInput) as inkTextInput).SetOffsetX(offset);
    };
  }
}

public class TagWidgetItem extends inkLogicController {

  private edit let m_selfRef: inkWidgetRef;

  private edit let m_tagText: inkRichTextBoxRef;

  private edit let m_tagVerticalPanelRef: inkWidgetRef;

  public final func SetTagName(inTagName: String) -> Void {
    inkTextRef.SetText(this.m_tagText, "#" + inTagName);
  }

  public final func SetCorrectSize() -> Void {
    let desiredSize: Vector2 = inkWidgetRef.GetDesiredSize(this.m_tagVerticalPanelRef);
    if desiredSize.X != 0.00 {
      inkWidgetRef.SetSize(this.m_selfRef, desiredSize);
    };
  }
}

public class UninstallConfirmationPopupController extends inkGameController {

  private edit let m_confirmButton: inkWidgetRef;

  private edit let m_cancelButton: inkWidgetRef;

  private edit let m_checkboxButton: inkWidgetRef;

  private edit let m_checkboxFill: inkWidgetRef;

  private edit let m_notificationText: inkTextRef;

  private edit let m_checkboxText: inkTextRef;

  private let m_bDontShowAgain: Bool;

  private let m_modMenuRef: wref<BrowserModsMenuGameController>;

  private let m_data: ref<ModioConfirmUninstallData>;

  private let m_widget: wref<inkWidget>;

  private let m_closeAnim: ref<inkAnimProxy>;

  protected cb func OnInitialize() -> Bool {
    this.PlayLibraryAnimation(n"UninstallPopup_In");
    inkWidgetRef.RegisterToCallback(this.m_confirmButton, n"OnRelease", this, n"OnConfirmButtonClicked");
    inkWidgetRef.RegisterToCallback(this.m_cancelButton, n"OnRelease", this, n"OnCancelButtonClicked");
    inkWidgetRef.RegisterToCallback(this.m_checkboxButton, n"OnRelease", this, n"OnCheckboxClicked");
    this.RegisterToGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    inkTextRef.SetText(this.m_notificationText, GetLocalizedText("UI-Modio-ErrorMessages-WarningUninstall"));
    inkTextRef.SetText(this.m_checkboxText, GetLocalizedText("UI-Modio-ErrorMessages-HideWarning"));
    this.m_bDontShowAgain = false;
    inkWidgetRef.SetVisible(this.m_checkboxFill, false);
    this.m_widget = this.GetRootWidget();
    this.m_data = this.GetRootWidget().GetUserData(n"ModioConfirmUninstallData") as ModioConfirmUninstallData;
    this.m_modMenuRef = this.m_data.m_ownerMenu;
    this.m_modMenuRef.DeactivateNavigation();
    this.m_modMenuRef.m_bStopListeningToInput = true;
  }

  protected cb func OnUninitialize() -> Bool {
    inkWidgetRef.UnregisterFromCallback(this.m_confirmButton, n"OnRelease", this, n"OnConfirmButtonClicked");
    inkWidgetRef.UnregisterFromCallback(this.m_cancelButton, n"OnRelease", this, n"OnCancelButtonClicked");
    inkWidgetRef.UnregisterFromCallback(this.m_checkboxButton, n"OnRelease", this, n"OnCheckboxClicked");
    this.UnregisterFromGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    this.m_modMenuRef.ActivateNavigation();
  }

  protected cb func OnButtonRelease(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"cancel") {
      this.Hide();
    } else {
      if evt.IsAction(n"mod_notification_confirm") {
        this.ConfirmUninstall();
      };
    };
  }

  public final func Hide() -> Void {
    this.m_modMenuRef.m_bStopListeningToInput = false;
    this.m_closeAnim = this.PlayLibraryAnimation(n"UninstallPopup_Out");
    this.m_closeAnim.RegisterToCallback(inkanimEventType.OnFinish, this, n"OnCloseAnimFinished");
    this.PlaySound(n"Button", n"OnPress");
  }

  protected cb func OnCloseAnimFinished(anim: ref<inkAnimProxy>) -> Bool {
    if this.m_closeAnim != null {
      this.m_closeAnim.UnregisterFromCallback(inkanimEventType.OnFinish, this, n"OnCloseAnimFinished");
      this.m_closeAnim = null;
    };
    this.m_data.token.TriggerCallback(null);
  }

  protected final func ConfirmUninstall() -> Void {
    this.m_modMenuRef.OnUninstallModConfirmationPopupClosed(true, this.m_bDontShowAgain);
    this.Hide();
  }

  protected cb func OnConfirmButtonClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.ConfirmUninstall();
    };
  }

  protected cb func OnCancelButtonClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.Hide();
    };
  }

  protected cb func OnCheckboxClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.m_bDontShowAgain = !this.m_bDontShowAgain;
      inkWidgetRef.SetVisible(this.m_checkboxFill, this.m_bDontShowAgain);
      this.PlaySound(n"Button", n"OnPress");
    };
  }
}

public class ShowFilterButton extends inkButtonController {

  private edit let m_textRef: inkWidgetRef;

  private edit let m_backgroundImage: inkWidgetRef;

  private edit let m_outlineImage: inkWidgetRef;

  private edit let m_iconImage: inkWidgetRef;

  private edit let m_hitboxCanvas: inkWidgetRef;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private let m_colorNames: ModsMenuColorsNames;

  protected cb func OnInitialize() -> Bool {
    this.RegisterCallbacks();
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterCallbacks();
  }

  public final func RegisterCallbacks() -> Void {
    inkWidgetRef.RegisterToCallback(this.m_hitboxCanvas, n"OnRelease", this, n"OnButtonRelease");
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
  }

  public final func UnregisterCallbacks() -> Void {
    inkWidgetRef.UnregisterFromCallback(this.m_hitboxCanvas, n"OnRelease", this, n"OnButtonRelease");
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
  }

  public final func SetOwnerMenu(ownerMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = ownerMenu;
    this.m_ownerMenu.AddToListOfNavigables(this);
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    if !this.m_ownerMenu.m_sortingDropdownListController.IsOpened() {
      this.SetHoveredColor();
    };
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    this.SetDefaultColor();
  }

  private final func SetHoveredColor() -> Void {
    inkWidgetRef.Get(this.m_textRef).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_iconImage).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_outlineImage).BindProperty(n"tintColor", this.m_colorNames.mildBlueName);
    inkWidgetRef.Get(this.m_backgroundImage).BindProperty(n"tintColor", this.m_colorNames.fullscreenPrimaryBackgroundDarkName);
  }

  public final func SetDefaultColor() -> Void {
    inkWidgetRef.Get(this.m_iconImage).BindProperty(n"tintColor", this.m_colorNames.redName);
    inkWidgetRef.Get(this.m_textRef).BindProperty(n"tintColor", this.m_colorNames.redName);
    inkWidgetRef.Get(this.m_backgroundImage).BindProperty(n"tintColor", this.m_colorNames.fullscreenRedDarkBackgroundName);
    inkWidgetRef.Get(this.m_outlineImage).BindProperty(n"tintColor", this.m_colorNames.darkerRedName);
  }

  protected cb func OnButtonRelease(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() || this.m_ownerMenu.m_sortingDropdownListController.IsOpened() {
      return true;
    };
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.m_ownerMenu.ShowFilterDrawer();
      this.SetDefaultColor();
    };
  }
}
