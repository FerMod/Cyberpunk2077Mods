  private edit let m_mainCarouselLoadingPanel: inkWidgetRef;

  private edit let m_leftCarouselLoadingPanel: inkWidgetRef;

  private edit let m_rightCarouselLoadingPanel: inkWidgetRef;

  private edit let m_loadingFailedPanelWidget: inkWidgetRef;

  private edit let m_mainCarouselImageController: inkWidgetRef;

  private edit let m_leftCarouselArrow: inkWidgetRef;

  private edit let m_rightCarouselArrow: inkWidgetRef;

  private edit let m_carouselText: inkTextRef;

  private edit let m_carouselTextShadow: inkTextRef;

  private edit let m_moreOptionsDropdownListManagerRef: inkWidgetRef;

  private edit let m_moreOptionsDropdownButtonManagerRef: inkWidgetRef;

  private edit let m_emptyAnimationWidget: inkWidgetRef;

  private edit let m_emptyPreviewCanvas: inkWidgetRef;

  private edit let m_topEmptyPreviewImage: inkWidgetRef;

  private edit let m_buttonEmptyPreviewImage: inkWidgetRef;

  private edit let m_middleEmptyPreviewImage: inkWidgetRef;

  private edit let m_lineEmptyPreviewImage: inkWidgetRef;

  private edit let m_bottomEmptyPreviewImage: inkWidgetRef;

  private edit let m_infoTitleEmptyPreviewImage: inkWidgetRef;

  private edit let m_infoDescEmptyPreviewImage: inkWidgetRef;

  private edit let m_modDetailsContent: inkWidgetRef;

  private edit let m_tagsGridWidgetRef: inkCompoundRef;

  private edit let m_pendingActivationOrDeactivationText: inkTextRef;

  private edit let m_scrollWidgetRef: inkWidgetRef;

  private edit let m_enableDisableToggleWidget: inkWidgetRef;

  private edit let m_enableDisableToggleText: inkTextRef;

  private edit let m_enableDisableToggleGradient: inkWidgetRef;

  private edit let m_enableDisableToggleUpperLine: inkWidgetRef;

  private edit let m_enableDisableToggleBottomLine: inkWidgetRef;

  public let m_enableDisableToggleNavController: wref<inkDiscreteNavigationController>;

  public let m_moreOptionsDropdownListController: wref<MoreOptionsDropdownListController>;

  public let m_moreOptionsDropdownButtonController: wref<MoreOptionsButtonController>;

  private let m_currentCarouselIndex: Int64;

  private let m_carouselImagePaths: [String];

  private let m_carouselSize: Int64;

  private let m_colorNames: ModsMenuColorsNames;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private let m_systemHandler: wref<inkISystemRequestsHandler>;

  private let m_isModTooBigToInstall: Bool;

  private let m_tagsItemArray: [wref<TagWidgetItem>];

  private let m_scrollController: wref<inkScrollController>;

  private let m_isModSubscribedByUser: Bool;

  private let m_enableDisableToggleAnimProxy: ref<inkAnimProxy>;

  private let m_bIsModEnabled: Bool;

  private let m_isToggleHovered: Bool;

  private let m_numberOfScreenshotRequestsForMainImage: Int32;

  private let m_numberOfScreenshotRequestsForLeftImage: Int32;

  private let m_numberOfScreenshotRequestsForRightImage: Int32;

  protected cb func OnInitialize() -> Bool {
    let animOptions: inkAnimOptions;
    let leftCarouselArrowController: wref<CarouselArrowController>;
    let rightCarouselArrowController: wref<CarouselArrowController>;
    let mainCarouselImageController: wref<ModioGalleryPreviewImageController> = inkWidgetRef.GetController(this.m_mainCarouselImageController) as ModioGalleryPreviewImageController;
    mainCarouselImageController.Setup(this);
    leftCarouselArrowController = inkWidgetRef.GetController(this.m_leftCarouselArrow) as CarouselArrowController;
    leftCarouselArrowController.InitializeCarouselArrow(true, this);
    rightCarouselArrowController = inkWidgetRef.GetController(this.m_rightCarouselArrow) as CarouselArrowController;
    rightCarouselArrowController.InitializeCarouselArrow(false, this);
    animOptions.playReversed = false;
    animOptions.loopType = inkanimLoopType.Cycle;
    animOptions.loopInfinite = true;
    this.PlayLibraryAnimation(n"Loading_ModDetails", animOptions);
    this.SetLoadingDataState();
    this.m_scrollController = inkWidgetRef.GetController(this.m_scrollWidgetRef) as inkScrollController;
    this.m_bIsModEnabled = false;
    this.m_isToggleHovered = false;
    this.m_numberOfScreenshotRequestsForMainImage = 0;
    this.m_numberOfScreenshotRequestsForLeftImage = 0;
    this.m_numberOfScreenshotRequestsForRightImage = 0;
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    this.m_enableDisableToggleNavController = inkWidgetRef.GetController(this.m_enableDisableToggleWidget) as inkDiscreteNavigationController;
    this.m_enableDisableToggleNavController.OverrideNavigation(inkDiscreteNavigationDirection.Up, inkWidgetRef.Get(this.m_subscriptionButton));
    inkWidgetRef.RegisterToCallback(this.m_enableDisableToggleWidget, n"OnRelease", this, n"OnEnableDisableToggleClicked");
    inkWidgetRef.RegisterToCallback(this.m_enableDisableToggleWidget, n"OnHoverOver", this, n"OnEnableDisableToggleHoverOver");
    inkWidgetRef.RegisterToCallback(this.m_enableDisableToggleWidget, n"OnHoverOut", this, n"OnEnableDisableToggleHoverOut");
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    inkWidgetRef.UnregisterFromCallback(this.m_enableDisableToggleWidget, n"OnRelease", this, n"OnEnableDisableToggleClicked");
    inkWidgetRef.UnregisterFromCallback(this.m_enableDisableToggleWidget, n"OnHoverOver", this, n"OnEnableDisableToggleHoverOver");
    inkWidgetRef.UnregisterFromCallback(this.m_enableDisableToggleWidget, n"OnHoverOut", this, n"OnEnableDisableToggleHoverOut");
  }

  protected cb func OnEnableDisableToggleClicked(evt: ref<inkPointerEvent>) -> Bool {
    if !this.m_moreOptionsDropdownListController.IsOpened() {
      if evt.IsAction(n"click") || evt.IsAction(n"tap") {
        this.PlaySound(n"Button", n"OnPress");
        this.m_ownerMenu.EnableOrDisableCurrentlyFocusedMod();
      };
    };
  }

  protected cb func OnEnableDisableToggleHoverOver(evt: ref<inkPointerEvent>) -> Bool {
    if !this.m_moreOptionsDropdownListController.IsOpened() && !this.m_ownerMenu.ShouldIgnoreInput() {
      inkWidgetRef.Get(this.m_enableDisableToggleGradient).BindProperty(n"tintColor", this.m_colorNames.fullscreenPrimaryBackgroundDarkName);
      inkWidgetRef.Get(this.m_enableDisableToggleGradient).BindProperty(n"opacity", n"MiniMapStyle.ExteriorWallOpacity");
      inkWidgetRef.Get(this.m_enableDisableToggleUpperLine).BindProperty(n"tintColor", this.m_colorNames.mildBlueName);
      inkWidgetRef.Get(this.m_enableDisableToggleBottomLine).BindProperty(n"tintColor", this.m_colorNames.mildBlueName);
      this.m_ownerMenu.DisplayTooltipOnEnableDisableToggle(this.m_bIsModEnabled, inkWidgetRef.Get(this.m_enableDisableToggleWidget));
      this.m_isToggleHovered = true;
    };
  }

  protected cb func OnEnableDisableToggleHoverOut(evt: ref<inkPointerEvent>) -> Bool {
    inkWidgetRef.Get(this.m_enableDisableToggleGradient).BindProperty(n"tintColor", this.m_colorNames.darkRedName);
    inkWidgetRef.Get(this.m_enableDisableToggleGradient).BindProperty(n"opacity", n"Briefings.BackgroundOpacity");
    inkWidgetRef.Get(this.m_enableDisableToggleUpperLine).BindProperty(n"tintColor", this.m_colorNames.darkerRedName);
    inkWidgetRef.Get(this.m_enableDisableToggleBottomLine).BindProperty(n"tintColor", this.m_colorNames.darkerRedName);
    this.m_ownerMenu.HideTooltips();
    this.m_isToggleHovered = false;
  }

  public final func SetLoadingDataState() -> Void {
    inkWidgetRef.Get(this.m_topEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_middleEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_lineEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_bottomEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_buttonEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_infoTitleEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_infoDescEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.SetOpacity(this.m_emptyPreviewCanvas, 0.20);
    inkWidgetRef.SetVisible(this.m_emptyPreviewCanvas, true);
    inkWidgetRef.SetVisible(this.m_emptyAnimationWidget, true);
    inkWidgetRef.SetVisible(this.m_modDetailsContent, false);
  }

  public final func RemoveLoadingDataState() -> Void {
    inkWidgetRef.SetVisible(this.m_emptyPreviewCanvas, false);
    inkWidgetRef.SetVisible(this.m_emptyAnimationWidget, false);
    inkWidgetRef.SetVisible(this.m_modDetailsContent, true);
  }

  public final func SetEmptyDataState() -> Void {
    this.RemoveLoadingDataState();
    inkWidgetRef.Get(this.m_topEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_middleEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_lineEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_bottomEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_buttonEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_infoTitleEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_infoDescEmptyPreviewImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.SetOpacity(this.m_emptyPreviewCanvas, 0.20);
    inkWidgetRef.SetVisible(this.m_emptyPreviewCanvas, true);
    inkWidgetRef.SetVisible(this.m_modDetailsContent, false);
