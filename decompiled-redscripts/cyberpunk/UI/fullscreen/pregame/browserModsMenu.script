  private let m_selectedFilterSpawnerController: wref<SelectedFilterGroup>;

  private let m_moreFilterTooltipString: String;

  private edit let m_showFiltersButtonRef: inkWidgetRef;

  private let m_showFilterButtonController: wref<ShowFilterButton>;

  private let m_hiddenModsInfoList: [ModioModInfos];

  @default(BrowserModsMenuGameController, false)
  private let m_bIsInGallery: Bool;

  private let m_systemHandler: wref<inkISystemRequestsHandler>;

  private let m_bCurrentlySelectedModIsEnabled: Bool;

  private let m_modioReportController: wref<ModioReportController>;

  private let m_currentSelectedModID: Int64;

  private let m_currentSelectedModName: String;

  private let m_onlineSystem: wref<IOnlineSystem>;

  private let m_isOffline: Bool;

  private let m_bIsOpenIMGDialog: Bool;

  @default(BrowserModsMenuGameController, false)
  private let m_bIsModHovered: Bool;

  @default(BrowserModsMenuGameController, false)
  private let m_bIsUserSubscribedToHoveredMod: Bool;

  @default(BrowserModsMenuGameController, false)
  public let m_bStopListeningToInput: Bool;

  private let m_searchBarNavigableComponent: wref<AnimatedListItemController>;

  private let m_listOfNavigableComponents: [wref<inkDiscreteNavigationController>];

  private let m_isNavigationActivated: Bool;

  private let m_waitingForNewModListState: Bool;

  protected cb func OnInitialize() -> Bool {
    let generalFluffWidget: ref<inkWidget>;
    super.OnInitialize();
    this.m_systemHandler = this.GetSystemRequestsHandler();
    this.m_tooltipManager = inkWidgetRef.GetControllerByType(this.m_tooltipManagerRef, n"gameuiTooltipsManager") as gameuiTooltipsManager;
    this.m_tooltipManager.Setup(ETooltipsStyle.Menus);
    this.m_menuNavigationController = inkWidgetRef.GetControllerByType(this.m_tooltipManagerRef, n"inkContainerNavigationController") as inkContainerNavigationController;
    this.m_menuNavigationController.SetInputDisabled(true);
    this.m_IgnoreNextEnableAction = false;
    this.m_IsInBrowserMenu = true;
    this.m_isNavigationActivated = true;
    this.m_waitingForNewModListState = true;
    inkWidgetRef.SetVisible(this.m_modVerificationPopupText, false);
    inkTextRef.SetText(this.m_playerUserNameText, "");
    this.SetupReport();
    this.m_buttonHintsController = this.SpawnFromExternal(inkWidgetRef.Get(this.m_buttonHintsManagerRef), r"base\\gameplay\\gui\\common\\buttonhints.inkwidget", n"Root").GetController() as ButtonHints;
    this.m_matureContentAndEnableAllModsCheckboxController = inkWidgetRef.GetController(this.m_matureContentCheckboxManagerRef) as MatureContentCheckbox;
    this.m_matureContentAndEnableAllModsCheckboxController.InitializeCheckbox(this);
    this.m_likedFilterCheckboxController = inkWidgetRef.GetController(this.m_likedContentCheckboxManagerRef) as LikedFilterCheckbox;
    this.m_likedFilterCheckboxController.InitializeCheckbox(this);
    this.SetMaxEnteredChars(inkWidgetRef.Get(this.m_searchBarTextInput) as inkTextInput);
    this.m_searchBarNavigableComponent = inkWidgetRef.GetControllerByType(this.m_searchBarArea, n"AnimatedListItemController") as AnimatedListItemController;
    this.AddToListOfNavigables(this.m_searchBarNavigableComponent);
    this.m_modsearchBarController = inkWidgetRef.GetController(this.m_searchBarControllerRef) as ModMenuSearchBarController;
    this.m_modsearchBarController.SetOwnerMenu(this);
    generalFluffWidget = this.SpawnFromExternal(this.GetRootWidget(), r"base\\gameplay\\gui\\fullscreen\\common\\general_fluff.inkwidget", n"Root");
    if this.IsPregame() {
      generalFluffWidget.SetMargin(0.00, -40.00, 0.00, 0.00);
    } else {
      generalFluffWidget.SetMargin(0.00, -80.00, 0.00, 0.00);
    };
    this.SetupDropdown();
    this.InitializeModGrid();
    this.CreatePageItems();
    this.CreateFilters();
    inkTextRef.SetText(this.m_modioBrowserHeaderTitle, GetLocalizedText("UI-Modio-MenuContent-Browser"));
    inkTextRef.SetText(this.m_modioCollectionHeaderTitle, GetLocalizedText("UI-Modio-MenuContent-Collection"));
    inkTextRef.SetText(this.m_modlistChangedText, GetLocalizedText("UI-Modio-ErrorMessages-WarningApplyChanges"));
    this.CreateModDetailsPanel();
    this.SwitchToBrowserView();
    this.RegisterMenuToCallbacks();
    this.m_onlineSystem = GameInstance.GetOnlineSystem(this.GetPlayerControlledObject().GetGame());
  }

  public final func IsPregame() -> Bool {
    return this.bIsPregame;
  }

  private final func RegisterMenuToCallbacks() -> Void {
    let platformName: String;
    this.RegisterToGlobalInputCallback(n"OnPostOnRelease", this, n"OnButtonRelease");
    this.RegisterToGlobalInputCallback(n"OnPostOnHold", this, n"OnHoldInput");
    this.RegisterToCallback(n"OnMenuUpdate", this, n"OnMenuUpdate");
    this.RegisterToCallback(n"OnSearchbarUpdate", this, n"OnSearchbarUpdate");
    this.RegisterToCallback(n"OnModDetailsUpdate", this, n"OnModDetailsUpdate");
    this.RegisterToCallback(n"OnButtonHintsUpdateRequested", this, n"OnButtonHintsUpdateRequested");
    this.RegisterToCallback(n"OnNewModSelected", this, n"OnNewModSelected");
    this.RegisterToCallback(n"OnProcessedModProgressUpdate", this, n"OnProcessedModProgressUpdate");
    this.RegisterToCallback(n"OnListOfModsToDisplayUpdated", this, n"OnListOfModsToDisplayUpdated");
    this.RegisterToCallback(n"OnPagesLayoutChanged", this, n"OnPagesLayoutChanged");
    this.RegisterToCallback(n"OnSwitchBetweenBrowserAndCollectionMenu", this, n"OnSwitchBetweenBrowserAndCollectionMenu");
    this.RegisterToCallback(n"OnRequestLogoForWidget", this, n"OnRequestLogoForWidget");
    this.RegisterToCallback(n"OnRequestedGalleryOnServer", this, n"OnRequestedGalleryOnServer");
    this.RegisterToCallback(n"OnRequestGalleryForWidget", this, n"OnRequestGalleryForWidget");
    this.RegisterToCallback(n"OnUserIdResult", this, n"OnUserIdResult");
    this.RegisterToCallback(n"OnLogoDownloadRequested", this, n"OnLogoDownloadRequested");
    this.RegisterToCallback(n"OnAllLanguagesCheckboxClicked", this, n"OnAllLanguagesCheckboxClicked");
    this.RegisterToCallback(n"OnCheckIfEnabledModsListChanged", this, n"OnCheckIfEnabledModsListChanged");
    this.RegisterToCallback(n"OnRateLimitedErrorReceived", this, n"OnRateLimitedErrorReceived");
    this.RegisterToCallback(n"OnRateLimitedErrorLifted", this, n"OnRateLimitedErrorLifted");
    this.RegisterToCallback(n"OnUpdateModVerificationPopupCount", this, n"OnUpdateModVerificationPopupCount");
    this.RegisterToCallback(n"OnModTagsReceived", this, n"OnModTagsReceived");
    this.RegisterToCallback(n"OnDelayedSpawnForFilters", this, n"OnDelayedSpawnForFilters");
    this.RegisterToCallback(n"OnDelayedSliderAdjustForDrawer", this, n"OnDelayedSliderAdjustForDrawer");
    this.RegisterToCallback(n"OnHiddenModListUpdated", this, n"OnHiddenModListUpdated");
    this.RegisterToCallback(n"OnAskedForNewModList", this, n"OnAskedForNewModList");
    this.m_sortingDropdownButtonController.RegisterToCallback(n"OnRelease", this, n"OnSortingButtonClicked");
    this.m_languageDropdownButtonController.RegisterToCallback(n"OnRelease", this, n"OnLanguageButtonClicked");
    inkWidgetRef.RegisterToCallback(this.m_searchBarTextInput, n"OnTextChanged", this, n"OnTextChanged");
    inkWidgetRef.RegisterToCallback(this.m_BrowserMenuTitleText, n"OnRelease", this, n"OnBrowserMenuTextClicked");
    inkWidgetRef.RegisterToCallback(this.m_CollectionMenuTitleText, n"OnRelease", this, n"OnCollectionMenuTextClicked");
    platformName = GetPlatformShortName();
    if Equals(platformName, "ps5") || Equals(platformName, "ps5pro") || Equals(platformName, "xseriesx") || Equals(platformName, "xseriess") || Equals(platformName, "emporium") {
      inkWidgetRef.SetInteractive(this.m_searchBarTextInput, false);
      inkWidgetRef.SetInteractive(this.m_searchBarArea, true);
      inkWidgetRef.RegisterToCallback(this.m_searchBarArea, n"OnPress", this, n"OnSearchBarPress");
      inkWidgetRef.RegisterToCallback(this.m_searchBarArea, n"OnHoverOut", this, n"OnSearchBarHoverOut");
    };
    if Equals(platformName, "mac") || Equals(platformName, "windows") || Equals(platformName, "windowsGDK") {
      inkWidgetRef.SetInteractive(this.m_searchBarArea, true);
      inkWidgetRef.RegisterToCallback(this.m_searchBarArea, n"OnPress", this, n"OnSearchBarPress");
    };
  }

  protected cb func OnRateLimitedErrorReceived() -> Bool {
    this.m_modPickerController.SetWarningStateOnGrid();
    this.m_modDetailItem.SetEmptyDataState();
  }

  protected cb func OnRateLimitedErrorLifted() -> Bool {
    this.m_modPickerController.RemoveWarningStateOnGrid();
  }

  protected cb func OnCheckIfEnabledModsListChanged(bEnabledModsListChanged: Bool) -> Bool {
    inkWidgetRef.SetVisible(this.m_modListChangedCanvas, bEnabledModsListChanged);
  }

  protected cb func OnBrowserMenuTextClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      if !this.m_IsInBrowserMenu {
        this.SwitchBetweenBrowserAndCollectionMenu();
      };
    };
  }

  public final func SetIsInGallery(bIsInGallery: Bool) -> Void {
    this.m_bIsInGallery = bIsInGallery;
  }

  public final func OnHiddenManagerOpened() -> Void {
    this.m_bStopListeningToInput = true;
    this.m_modDetailItem.SetScrollbarEnable(!this.m_bStopListeningToInput);
  }

  public final func OnHiddenManagerClosed() -> Void {
    this.m_bStopListeningToInput = false;
    this.m_modDetailItem.SetScrollbarEnable(!this.m_bStopListeningToInput);
  }

  public final func IsReportPopupOpen() -> Bool {
    return IsDefined(this.m_modioReportController) && !this.m_modioReportController.IsClosed();
  }

  public final func IsFilterDrawerOpen() -> Bool {
    return this.m_filterDrawer.IsOpen();
  }

  public final func ShouldIgnoreInput() -> Bool {
    return this.IsReportPopupOpen() || this.IsFilterDrawerOpen() || this.m_bStopListeningToInput;
  }

  protected cb func OnCollectionMenuTextClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      if this.m_IsInBrowserMenu {
        this.SwitchBetweenBrowserAndCollectionMenu();
      };
    };
  }

  private final func SetPlayerName(playerName: String) -> Void {
    if !IsFinal() && (Equals(GetPlatformShortName(), "windows") || Equals(GetPlatformShortName(), "windowsGDK")) && Equals(playerName, "") {
      return;
    };
    inkTextRef.SetText(this.m_playerUserNameText, playerName);
  }

  private final func PushErrorPopup(title: CName, description: CName, opt errorCode: Uint32) -> Void {
    let errorPopupEvt: ref<OpenExpansionErrorPopupEvent> = new OpenExpansionErrorPopupEvent();
    errorPopupEvt.m_title = title;
    errorPopupEvt.m_description = description;
    errorPopupEvt.m_errorCode = errorCode;
    errorPopupEvt.m_modMenu = this;
    this.QueueBroadcastEvent(errorPopupEvt);
  }

  public final func WarnAboutImpossibleActionInPauseMenu() -> Void {
    this.m_systemHandler.RequestSystemNotificationGeneric(n"UI-Modio-ErrorMessages-PopupTitle", n"UI-Modio-Tooltips-PreventActionInPause");
  }

  private final func InitializeModGrid() -> Void {
    this.m_modPickerController = inkWidgetRef.GetController(this.m_modPickerRef) as browserModsMenuModPicker;
    this.m_modPickerController.InitializeGrid(this);
  }

  private final func CreatePageItems() -> Void {
    let currentPageSelectorItem: wref<PageSelectorItem>;
    let currentlyCreatedWidget: ref<inkWidget>;
    let i: Int32 = 0;
    while i < 9 {
      currentlyCreatedWidget = this.SpawnFromLocal(inkWidgetRef.Get(this.m_PageSelectorPanelRef), n"PageSelectorItem");
      currentPageSelectorItem = currentlyCreatedWidget.GetController() as PageSelectorItem;
      currentPageSelectorItem.SetOwnerMenu(this);
      currentPageSelectorItem.HidePageItem(this);
      ArrayPush(this.m_PageSelectorItemWidgetList, currentlyCreatedWidget);
      i += 1;
    };
    this.m_leftPageArrowController = inkWidgetRef.GetController(this.m_leftPageArrowRef) as ModPaginationArrowController;
    this.m_leftPageArrowController.InitializeModPaginationArrow(true, this);
    this.m_rightPageArrowController = inkWidgetRef.GetController(this.m_rightPageArrowRef) as ModPaginationArrowController;
    this.m_rightPageArrowController.InitializeModPaginationArrow(false, this);
  }

  private final func SetupDropdown() -> Void {
    this.m_sortingDropdownListController = inkWidgetRef.GetController(this.m_sortingDropdownListManagerRef) as ModSortingDropdownListController;
    this.m_sortingDropdownButtonController = this.SpawnFromLocal(inkWidgetRef.Get(this.m_sortingDropdownButtonManagerRef), n"SortingDropdownButton").GetController() as ModSortingDropdownButtonController;
    this.m_sortingDropdownButtonController.SetOwnerMenu(this);
    this.m_sortingDropdownListController.SetOwnerMenu(this);
    this.UpdateDropdownContext();
  }

  public final func ActivateNavigation() -> Void {
    let i: Int32;
    this.m_menuNavigationController.ActivateNavigationCallback();
    this.m_isNavigationActivated = true;
    i = 0;
    while i < ArraySize(this.m_listOfNavigableComponents) {
      this.m_listOfNavigableComponents[i].SetNavigable(true);
      i += 1;
    };
  }

  public final func DeactivateNavigation() -> Void {
    let i: Int32;
    this.m_isNavigationActivated = false;
    this.m_menuNavigationController.DeactivateNavigationCallback();
    i = 0;
    while i < ArraySize(this.m_listOfNavigableComponents) {
      this.m_listOfNavigableComponents[i].SetNavigable(false);
      i += 1;
    };
  }

  public final func ActivateNavigables() -> Void {
    let i: Int32 = 0;
    while i < ArraySize(this.m_listOfNavigableComponents) {
      this.m_listOfNavigableComponents[i].SetNavigable(true);
      i += 1;
    };
  }

  public final func DeactivateNavigables() -> Void {
    let i: Int32 = 0;
    while i < ArraySize(this.m_listOfNavigableComponents) {
      this.m_listOfNavigableComponents[i].SetNavigable(false);
      i += 1;
    };
  }

  public final func GetIsNavigationActive() -> Bool {
    return this.m_isNavigationActivated;
  }

  public final func AddToListOfNavigables(inNavigable: ref<inkDiscreteNavigationController>) -> Void {
    ArrayPush(this.m_listOfNavigableComponents, inNavigable);
    inNavigable.SetNavigable(this.m_isNavigationActivated);
  }

  public final func RemoveFromListOfNavigables(inNavigable: ref<inkDiscreteNavigationController>) -> Void {
    ArrayRemove(this.m_listOfNavigableComponents, inNavigable);
  }

  public final func AskIfUserReallyWantToUnsubscribe() -> Void {
    let previewEvent: ref<ModioConfirmUninstallPopupEvent> = new ModioConfirmUninstallPopupEvent();
    previewEvent.m_data = new ModioConfirmUninstallData();
    previewEvent.m_data.queueName = n"modio_uninstallConfirm";
    previewEvent.m_data.notificationName = n"base\\gameplay\\gui\\fullscreen\\main_menu\\modio\\modio_uninstall_confirmation_popup.inkwidget";
    previewEvent.m_data.isBlocking = true;
    previewEvent.m_data.useCursor = true;
    previewEvent.m_data.m_ownerMenu = this;
    this.QueueBroadcastEvent(previewEvent);
  }

  public final func OnUninstallModConfirmationPopupClosed(bConfirmUninstall: Bool, bDoNotDisplayThePopupAgain: Bool) -> Void {
    if bConfirmUninstall {
      this.SubscribeToModButtonClicked(false);
      if bDoNotDisplayThePopupAgain {
        this.StopDisplayUninstallConfirmationPopup();
      };
    };
  }

  private final func UpdateDropdownContext() -> Void {
    let languageButtonController: ref<LanguageDropdownButtonController>;
    let languageListController: ref<LanguageDropdownListController>;
    let sortingListController: ref<ModSortingDropdownListController> = this.m_sortingDropdownListController;
    let sortingButtonController: ref<ModSortingDropdownButtonController> = this.m_sortingDropdownButtonController.GetController() as ModSortingDropdownButtonController;
    sortingListController.Setup(this, ModSortingDropdownData.GetSortingDropdownOptions(), sortingButtonController);
    sortingButtonController.SetData(ModSortingDropdownData.GetSortingDropdownOption(sortingListController.GetData(), inkModioModSortingOptions.Trending));
    languageListController = this.m_languageDropdownListController;
    languageButtonController = this.m_languageDropdownButtonController.GetController() as LanguageDropdownButtonController;
    languageListController.Setup(this, ModLanguageDropdownData.GetLanguageDropdownOptions(), languageButtonController);
    languageButtonController.SetData(ModLanguageDropdownData.GetLanguageDropdownOption(languageListController.GetData(), inkModioLanguageTagsOptions.AllLanguages));
  }

  protected cb func OnModTagsReceived(tagInputsReceived: [inkModFilterDrawerInput]) -> Bool {
    this.SetupFilterDrawer(tagInputsReceived);
  }

  public final func SetupFilterDrawer(tagInputsReceived: [inkModFilterDrawerInput]) -> Void {
    this.m_filterDrawer = this.SpawnFromExternal(this.GetRootWidget(), r"base\\gameplay\\gui\\fullscreen\\main_menu\\modio\\mod_filter_drawer.inkwidget", n"Root").GetController() as ModMenuFilterDrawer;
    this.m_filterDrawer.Setup(this, tagInputsReceived);
    this.m_selectedFilterSpawnerController = inkWidgetRef.GetController(this.m_selectedFilterSpawner) as SelectedFilterGroup;
    this.m_selectedFilterSpawnerController.Setup(this, this.m_filterDrawer);
    this.m_showFilterButtonController = inkWidgetRef.GetController(this.m_showFiltersButtonRef) as ShowFilterButton;
    this.m_showFilterButtonController.SetOwnerMenu(this);
  }

  public final func ShowFilterDrawer() -> Void {
    this.PlaySound(n"Button", n"OnPress");
    this.m_filterDrawer.Show();
    inkWidgetRef.SetVisible(this.m_modDetailsPanelSnapshot, false);
    this.UpdateButtonHints();
    this.DeactivateNavigation();
    this.m_showFilterButtonController.SetDefaultColor();
  }

  public final func HideFilterDrawer() -> Void {
    this.PlaySound(n"Button", n"OnPress");
    this.m_filterDrawer.Hide();
    inkWidgetRef.SetVisible(this.m_modDetailsPanelSnapshot, true);
    this.RequestModDetailsUpdateNextFrame();
    this.UpdateButtonHints();
    this.ActivateNavigation();
  }

  public final func ChangeLikeFilterStateFromDrawer(bInActivated: Bool) -> Void {
    this.ChangeLikeFilterState(bInActivated);
  }

  public final func UpdateFiltersFromDrawer(drawerOutputList: [ModFilterDrawerOutput]) -> Void {
    let currentOutput: ModFilterDrawerOutput;
    let i: Int32;
    let languageFilterTags: array<String>;
    let nonLanguageFilterTags: array<String>;
    this.m_selectedFilterSpawnerController.MarkAllFiltersAsDelete();
    i = 0;
    while i < ArraySize(drawerOutputList) {
      currentOutput = drawerOutputList[i];
      if currentOutput.m_bIsExceptionFilter {
      } else {
        if currentOutput.m_bIsLanguageFilter {
          ArrayPush(languageFilterTags, currentOutput.m_activeFilterName);
        } else {
          ArrayPush(nonLanguageFilterTags, currentOutput.m_activeFilterName);
        };
      };
      this.m_selectedFilterSpawnerController.AddFilter(currentOutput.m_activeFilterName, currentOutput.m_localizedFilterName, currentOutput.m_bIsExceptionFilter);
      i += 1;
    };
    this.RequestDelayedSpawnForSelectedFilters();
    this.UpdateFiltersFromDrawer(nonLanguageFilterTags, languageFilterTags);
  }

  protected cb func OnDelayedSliderAdjustForDrawer() -> Bool {
    this.m_filterDrawer.AdjustScrollbarAfterFolderManipulation();
  }

  protected cb func OnDelayedSpawnForFilters() -> Bool {
    let currentFilter: ref<SelectedFilterItem>;
    let i: Int32;
    let listOfFilters: array<wref<SelectedFilterItem>>;
    let cumulatedWidth: Float = 0.00;
    let hiddenFiltersNb: Int32 = 0;
    this.m_moreFilterTooltipString = "";
    let spawnerWidgetChildMargin: inkMargin = (inkWidgetRef.Get(this.m_selectedFilterSpawner) as inkCompoundWidget).GetChildMargin();
    let spawnerWidgetChildRightMargin: Float = spawnerWidgetChildMargin.right;
    this.m_selectedFilterSpawnerController.DeleteMarkedFilters();
    listOfFilters = this.m_selectedFilterSpawnerController.GetListOfFilters();
    i = 0;
    while i < ArraySize(listOfFilters) {
      currentFilter = listOfFilters[i];
      cumulatedWidth += currentFilter.GetDesiredWidth() + spawnerWidgetChildRightMargin;
      if cumulatedWidth < 1500.00 {
        currentFilter.GetRootWidget().SetVisible(true);
      } else {
        hiddenFiltersNb += 1;
        currentFilter.GetRootWidget().SetAffectsLayoutWhenHidden(false);
        if hiddenFiltersNb > 1 {
          this.m_moreFilterTooltipString += " / ";
        };
        this.m_moreFilterTooltipString += currentFilter.GetLocalizedFilterName();
      };
      i += 1;
    };
    if hiddenFiltersNb > 0 {
      currentFilter = this.m_selectedFilterSpawnerController.AddExceptionMoreFilter(hiddenFiltersNb);
      currentFilter.UnregisterFromCallback(n"OnHoverOver", this, n"OnPlusFilterHoveredOver");
      currentFilter.UnregisterFromCallback(n"OnHoverOut", this, n"OnPlusFilterHoveredOut");
      currentFilter.RegisterToCallback(n"OnHoverOver", this, n"OnPlusFilterHoveredOver");
      currentFilter.RegisterToCallback(n"OnHoverOut", this, n"OnPlusFilterHoveredOut");
    };
  }

  protected cb func OnPlusFilterHoveredOver(e: ref<inkPointerEvent>) -> Bool {
    let tooltipData: ref<MessageTooltipData>;
    if this.ShouldIgnoreInput() {
      return true;
    };
    tooltipData = new MessageTooltipData();
    tooltipData.Title = GetLocalizedText(this.m_moreFilterTooltipString);
    this.m_tooltipManager.ShowTooltipAtWidget(0, e.GetTarget(), tooltipData, gameuiETooltipPlacement.RightTop, true);
  }

  protected cb func OnPlusFilterHoveredOut(e: ref<inkPointerEvent>) -> Bool {
    this.m_tooltipManager.HideTooltips();
  }

  protected cb func OnHiddenModListUpdated(hiddenModList: [ModioModInfos]) -> Bool {
    this.m_hiddenModsInfoList = hiddenModList;
  }

  protected cb func OnAskedForNewModList() -> Bool {
