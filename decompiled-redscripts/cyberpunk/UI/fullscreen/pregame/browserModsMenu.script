  protected cb func OnNewModSelected(inModInfo: ModioModInfos, inModInfoProgress: ModioModProgressInfo, inSelectedPanelID: Int32, fromAuthor: Int64, bIsModCurrentlyBeingProcesssed: Bool, bIsPendingActivationOrDeactivation: Bool) -> Bool {
    let authorController: ref<FromAuthorButtonController>;
    let bIsFilteringByAuthor: Bool;
    let downloadProgressBarController: ref<ModPanelDownloadProgressBarController>;
    let likeController: ref<LikeButtonController>;
    let subscribeController: ref<SubscribeToModButtonController>;
    if this.m_currentSelectedModID != inModInfo.id {
      this.m_modDetailItem.InitializeModDetails(inModInfo, this.m_systemHandler, this.GetRemainingSpaceOnUserDisk(), this.GetRemainingSpaceOnUserDiskText());
    } else {
      this.m_modDetailItem.PlayEnableDisableToggleTransitionAnimationIfNeeded(inModInfo.bIsUserSubscribedToMod, inModInfo.bIsModEnabledForUser);
      this.m_modDetailItem.RemoveLoadingDataState();
    };
    this.m_modDetailItem.AdjustCosmeticsForLikesAndDownloads(inModInfo);
    this.m_modDetailItem.EditPendingActivationOrDeactivationText(bIsPendingActivationOrDeactivation, inModInfo.bIsModEnabledForUser);
    if inModInfo.id == 0l {
      this.m_modDetailItem.SetEmptyDataState();
    };
    this.m_modDetailItem.ApplyCorrectColor(inModInfo.bIsUserSubscribedToMod, !inModInfo.bIsModEnabledForUser);
    this.m_bCurrentlySelectedModIsEnabled = inModInfo.bIsModEnabledForUser;
    this.m_currentlySelectedModEntry.ApplyUnselectedColor();
    this.m_currentlySelectedModEntry = this.m_modPickerController.m_modEntryItemList[inSelectedPanelID].GetController() as ModEntryItem;
    if inModInfo.id != 0l {
      this.m_currentlySelectedModEntry.ApplySelectedColor();
    } else {
      this.m_currentlySelectedModEntry.ApplyUnselectedColor();
    };
    if !inModInfo.bIsModNewForUser {
      this.m_currentlySelectedModEntry.RemoveNewModIcon();
    };
    subscribeController = inkWidgetRef.GetController(this.m_modDetailItem.m_subscriptionButton) as SubscribeToModButtonController;
    if this.m_modDetailItem.ShouldPreventSubscribing(inModInfo.bIsUserSubscribedToMod) {
      subscribeController.SetIsDisabledForOutOfSpaceReason(true);
    } else {
      subscribeController.SetIsDisabled(bIsModCurrentlyBeingProcesssed);
    };
    subscribeController.SetButtonInfo(inModInfo.bIsUserSubscribedToMod);
    likeController = inkWidgetRef.GetController(this.m_modDetailItem.m_likeButton) as LikeButtonController;
    likeController.SetIsDisabled(bIsModCurrentlyBeingProcesssed);
    likeController.SetButtonInfo(inModInfo.bIsUserLikingMod);
    authorController = inkWidgetRef.GetController(this.m_modDetailItem.m_authorButton) as FromAuthorButtonController;
    bIsFilteringByAuthor = fromAuthor == 0l ? false : fromAuthor == inModInfo.authorID;
    authorController.SetButtonInfo(bIsFilteringByAuthor);
    this.m_moreOptionsController.SetIsDisabled(bIsModCurrentlyBeingProcesssed);
    downloadProgressBarController = inkWidgetRef.GetController(this.m_modDetailItem.m_downloadProgressBar) as ModPanelDownloadProgressBarController;
    if inModInfoProgress.modID == -1l || inModInfoProgress.modID != inModInfo.id {
      downloadProgressBarController.SetGlobalVisibility(false);
    } else {
      downloadProgressBarController.SetGlobalVisibility(true);
      downloadProgressBarController.SetProgress(inModInfoProgress.progressRate);
      downloadProgressBarController.SetProgressTextFromProgress(inModInfoProgress.progressState);
    };
    this.RequestButtonHintUpdateNextFrame();
    this.m_currentSelectedModID = inModInfo.id;
    this.m_currentSelectedModName = inModInfo.name;
  }

  protected cb func OnProcessedModProgressUpdate(inModInfoProgress: ModioModProgressInfo, currentlySelectedMod: Int64, currentlyDisplayedModInfos: [ModioModInfos]) -> Bool {
    let downloadProgressBarController: ref<ModPanelDownloadProgressBarController> = inkWidgetRef.GetController(this.m_modDetailItem.m_downloadProgressBar) as ModPanelDownloadProgressBarController;
    if inModInfoProgress.modID == -1l || inModInfoProgress.modID != currentlySelectedMod {
      downloadProgressBarController.SetGlobalVisibility(false);
    } else {
      downloadProgressBarController.SetGlobalVisibility(true);
      downloadProgressBarController.SetProgress(inModInfoProgress.progressRate);
      downloadProgressBarController.SetProgressTextFromProgress(inModInfoProgress.progressState);
    };
    this.m_modPickerController.UpdateProgress(inModInfoProgress, currentlyDisplayedModInfos);
  }

  protected cb func OnListOfModsToDisplayUpdated(modList: [ModioModInfos], modProgressInfo: ModioModProgressInfo) -> Bool {
    this.m_modPickerController.UpdateGrid(modList, modProgressInfo);
    this.m_waitingForNewModListState = false;
    this.UpdateButtonHints();
  }

  protected cb func OnSwitchBetweenBrowserAndCollectionMenu(bIsBrowserMode: Bool) -> Bool {
    this.m_IsInBrowserMenu = bIsBrowserMode;
    if bIsBrowserMode {
      this.SwitchToBrowserView();
    } else {
      this.SwitchToCollectionView();
    };
  }

  protected cb func OnRequestLogoForWidget(inPanelID: Int32, modLogoPath: String) -> Bool {
    let currentModEntryItem: ref<ModEntryItem> = this.m_modPickerController.m_modEntryItemList[inPanelID].GetController() as ModEntryItem;
    let widget: ref<inkImage> = currentModEntryItem.GetLogoWidget();
    currentModEntryItem.HandleScreenshotRequest();
    this.m_systemHandler.RequestGameScreenshotByPath(modLogoPath, widget, currentModEntryItem, n"OnScreenshotLoadedByPath");
  }

  protected cb func OnRequestedGalleryOnServer(inGalleryImageIndex: Int32) -> Bool {
    this.m_modDetailItem.ReceiveNewGalleryIntent(inGalleryImageIndex);
  }

  protected cb func OnRequestGalleryForWidget(inGalleryImageIndex: Int32, modGalleryPath: String) -> Bool {
    this.m_modDetailItem.ReceiveNewGalleryImage(inGalleryImageIndex, modGalleryPath);
  }

  private final func SwitchToBrowserView() -> Void {
    inkWidgetRef.Get(this.m_BrowserMenuTitleText).BindProperty(n"tintColor", n"MainColors.ActiveBlue");
    inkWidgetRef.Get(this.m_CollectionMenuTitleText).BindProperty(n"tintColor", n"MainColors.ActiveRed");
    this.UpdateButtonHints();
  }

  private final func SwitchToCollectionView() -> Void {
    inkWidgetRef.Get(this.m_BrowserMenuTitleText).BindProperty(n"tintColor", n"MainColors.ActiveRed");
    inkWidgetRef.Get(this.m_CollectionMenuTitleText).BindProperty(n"tintColor", n"MainColors.ActiveBlue");
    this.UpdateButtonHints();
  }

  public final func IsGameOnConsole() -> Bool {
    let platformName: String = GetPlatformShortName();
    if Equals(platformName, "ps5") || Equals(platformName, "ps5pro") || Equals(platformName, "xseriesx") || Equals(platformName, "xseriess") || Equals(platformName, "emporium") {
      return true;
    };
    return false;
  }

  public final func UpdateButtonHints() -> Void {
    let EnableOrDisableAllString: String;
    let EnableOrDisableString: String;
    let bIsCurrentlySelectedModInstalled: Bool;
    let bIsCurrentlySelectedModSubscribed: Bool;
    let bShouldActionEnable: Bool;
    this.m_buttonHintsController.ClearButtonHints();
    if this.IsFilterDrawerOpen() {
      this.m_buttonHintsController.AddButtonHint(n"back", GetLocalizedText("Common-Access-Close"));
      this.m_buttonHintsController.AddButtonHint(n"focus_search_bar", GetLocalizedText("UI-Modio-FiltersSorting-Reset"));
    } else {
      this.m_buttonHintsController.AddButtonHint(n"back", this.IsSearchBarFocused() ? GetLocalizedText("UI-UserActions-NavigateBack") : GetLocalizedText("Common-Access-Close"));
      if !this.IsSearchBarFocused() {
        this.m_buttonHintsController.AddButtonHint(n"display_filter_drawer", GetLocalizedText("UI-Modio-InputHints-Filters"));
        if this.IsGameOnConsole() {
          this.m_buttonHintsController.AddButtonHint(n"focus_search_bar", GetLocalizedText("UI-Modio-InputHints-Search"));
        };
        if !this.m_waitingForNewModListState {
          this.m_buttonHintsController.AddButtonHint(n"select", GetLocalizedText("UI-UserActions-Select"));
          bIsCurrentlySelectedModInstalled = this.GetIsSelectedModInstalled();
          if bIsCurrentlySelectedModInstalled {
            bShouldActionEnable = !this.m_bCurrentlySelectedModIsEnabled;
            EnableOrDisableString = !bShouldActionEnable ? GetLocalizedText("UI-Modio-InputHints-Disable") : GetLocalizedText("UI-Modio-InputHints-Enable");
            this.m_buttonHintsController.AddButtonHint(n"enable_or_disable_mod", EnableOrDisableString);
            if !this.m_IsInBrowserMenu {
              EnableOrDisableAllString = !bShouldActionEnable ? GetLocalizedText("UI-Modio-FiltersSorting-DisableAll") : GetLocalizedText("UI-Modio-FiltersSorting-EnableAll");
              this.m_buttonHintsController.AddButtonHint(n"enable_or_disable_all_mods", "[" + GetLocalizedText("Gameplay-Devices-Interactions-Helpers-Hold") + "] " + EnableOrDisableAllString);
            };
          };
          bIsCurrentlySelectedModSubscribed = this.GetIsUserSubscribedToSelectedMod();
          if !bIsCurrentlySelectedModSubscribed {
            this.m_buttonHintsController.AddButtonHint(n"subscribe_to_mod", GetLocalizedText("UI-Modio-InputHints-Install"));
          } else {
            if bIsCurrentlySelectedModInstalled {
              this.m_buttonHintsController.AddButtonHint(n"subscribe_to_mod", GetLocalizedText("UI-Modio-InputHints-Uninstall"));
            };
          };
          this.m_buttonHintsController.AddButtonHint(n"display_hidden_mods", GetLocalizedText("UI-Modio-MenuContent-ManageHiddenMods"));
        };
      };
    };
  }

  protected cb func OnPageClicked(e: ref<inkPointerEvent>) -> Bool {
    let button: wref<inkWidget>;
    let controller: wref<PageSelectorItem>;
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      button = e.GetCurrentTarget();
      controller = button.GetController() as PageSelectorItem;
      this.UpdateCurrentlySelectedPage(controller.m_pageNumber);
    };
  }

  protected cb func OnPagesLayoutChanged(newNumberOfPages: Int32, currentlySelectedPage: Int32) -> Bool {
    this.DisplayCorrectPagesLayout(newNumberOfPages, currentlySelectedPage);
  }

  private final func DisplayCorrectPagesLayout(newNumberOfPages: Int32, currentlySelectedPage: Int32) -> Void {
    let currentPageSelectorIndex: Int32;
    let i: Int32;
    this.ShowPage(this.m_PageSelectorItemWidgetList[0], 1, currentlySelectedPage);
    currentPageSelectorIndex = 1;
    if currentlySelectedPage > 4 {
      if currentlySelectedPage == 5 {
        this.ShowPage(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex], 2, currentlySelectedPage);
      } else {
        this.ShowSeparator(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex]);
      };
      currentPageSelectorIndex += 1;
    };
    i = Max(2, currentlySelectedPage - 2);
    while i <= Min(newNumberOfPages - 1, currentlySelectedPage + 2) {
      this.ShowPage(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex], i, currentlySelectedPage);
      currentPageSelectorIndex += 1;
      i += 1;
    };
    if currentlySelectedPage < newNumberOfPages - 3 {
      if i + 1 != newNumberOfPages {
        this.ShowSeparator(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex]);
        currentPageSelectorIndex += 1;
      } else {
        this.ShowPage(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex], i, currentlySelectedPage);
        currentPageSelectorIndex += 1;
      };
    };
    if newNumberOfPages > 1 {
      this.ShowPage(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex], newNumberOfPages, currentlySelectedPage);
      currentPageSelectorIndex += 1;
    };
    currentPageSelectorIndex;
    while currentPageSelectorIndex < 9 {
      this.HidePage(this.m_PageSelectorItemWidgetList[currentPageSelectorIndex]);
      currentPageSelectorIndex += 1;
    };
  }

  private final func ShowPage(inPageWidget: ref<inkWidget>, inPageValue: Int32, inCurrentlySelectedPage: Int32) -> Void {
    let inPageSelectorItem: ref<PageSelectorItem> = inPageWidget.GetController() as PageSelectorItem;
    inPageSelectorItem.ShowPageItem(this, inPageValue, inCurrentlySelectedPage);
  }

  private final func ShowSeparator(inPageWidget: ref<inkWidget>) -> Void {
    let inPageSelectorItem: ref<PageSelectorItem> = inPageWidget.GetController() as PageSelectorItem;
    inPageSelectorItem.SetAsPageSeparator(this);
  }

  private final func HidePage(inPageWidget: ref<inkWidget>) -> Void {
    let inPageSelectorItem: ref<PageSelectorItem> = inPageWidget.GetController() as PageSelectorItem;
    inPageSelectorItem.HidePageItem(this);
  }

  private final func SetupReport() -> Void {
    this.m_modioReportController = this.SpawnFromExternal(this.GetRootWidget(), r"base\\gameplay\\gui\\fullscreen\\main_menu\\modio\\modio_report.inkwidget", n"Root").GetController() as ModioReportController;
    this.m_modioReportController.GetRootWidget().SetVisible(false);
  }

  public final func OnReportClick() -> Void {
    this.m_modioReportController.OnOpen();
    this.m_modioReportController.SetSystemHandler(this.m_systemHandler);
    this.m_modioReportController.SetModMenuController(this);
    this.m_modioReportController.SetModID(this.m_currentSelectedModID);
    this.m_modioReportController.SetModName(this.m_currentSelectedModName);
    this.DeactivateNavigation();
  }

  protected cb func OnOnlineStatusChanged(value: GOGRewardsSystemStatus) -> Bool {
    let error: GOGRewardsSystemErrors = this.m_onlineSystem.GetError();
    if Equals(error, GOGRewardsSystemErrors.NoInternetConnection) {
      if !this.m_isOffline {
        this.m_isOffline = true;
        this.m_systemHandler.RequestSystemNotificationGenericYesNo(n"UI-Modio-ErrorMessages-PopupTitle", n"UI-Modio-ErrorMessages-ModioOutage", this, n"OnShowNetworkErrorMsgResult", false);
      };
    } else {
      if this.m_isOffline {
        this.m_isOffline = false;
      };
    };
  }

  protected cb func OnShowNetworkErrorMsgResult(value: Bool) -> Bool {
    this.m_eventDispatcher.SpawnEvent(n"OnMainMenuBack");
  }

  protected cb func OnSearchBarPress(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") {
      this.OpenIMEDialogIfNeeded();
    };
  }

  public final func OpenIMEDialogIfNeeded() -> Void {
    let voName: CName;
    let voVar: ref<ConfigVarListName>;
    let platformName: String = GetPlatformShortName();
    if Equals(platformName, "xseriesx") || Equals(platformName, "xseriess") || Equals(platformName, "emporium") {
      if !this.m_bIsOpenIMGDialog {
        Modio.OpenIMEDialog((inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).GetText(), this, n"OnOpenIMEDialogResult");
        this.m_bIsOpenIMGDialog = true;
      } else {
        this.m_bIsOpenIMGDialog = false;
      };
    } else {
      if Equals(platformName, "ps5") || Equals(platformName, "ps5pro") {
        Modio.OpenIMEDialog((inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).GetText(), this, n"OnOpenIMEDialogResult");
      } else {
        if Equals(platformName, "mac") || Equals(platformName, "windows") || Equals(platformName, "windowsGDK") {
          voVar = this.m_systemHandler.GetUserSettings().GetVar(n"/language", n"OnScreen") as ConfigVarListName;
          if IsDefined(voVar) {
            voName = voVar.GetValue();
            if Equals(voName, n"ja") || Equals(voName, n"ko") || Equals(voName, n"zh-cn") || Equals(voName, n"zh-tw") {
              Modio.OpenIMEDialog((inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).GetText(), this, n"OnOpenIMEDialogResult", 30);
            };
          };
        };
      };
    };
  }

  protected cb func OnOpenIMEDialogResult(str: String, hasResult: Bool) -> Bool {
    let maxChars: Uint32;
    if hasResult {
      maxChars = (inkWidgetRef.Get(this.m_searchBarTextInput) as inkTextInput).GetMaxChars();
      if maxChars > 0u && StrLen(str) > Cast<Int32>(maxChars) {
        (inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).SetText(Modio.SubStrByChar(str, 0, Cast<Int32>(maxChars)));
      } else {
        if StrLen(str) == 0 {
          this.m_modsearchBarController.Reset();
          (inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).SetText(str);
        } else {
          (inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).SetText(str);
        };
      };
    } else {
      this.m_modsearchBarController.Reset();
      (inkWidgetRef.Get(this.m_searchBarTextInput) as inkText).SetText("");
    };
    this.m_modsearchBarController.DisplayDefaultTextIfEmpty();
  }

  protected cb func OnSearchBarHoverOut(e: ref<inkPointerEvent>) -> Bool {
    this.RequestSetFocus(null);
  }
}

public class browserModsMenuModPicker extends inkLogicController {

  private edit let m_grid: inkUniformGridRef;

  public let m_modEntryItemList: [wref<inkWidget>];

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  public final func InitializeGrid(ownerMenu: ref<BrowserModsMenuGameController>) -> Void {
    let currentModEntry: ref<ModEntryItem>;
    let currentModPanel: ref<inkWidget>;
    this.m_ownerMenu = ownerMenu;
    let i: Int32 = 0;
    while i < 9 {
      currentModPanel = this.SpawnFromLocal(inkWidgetRef.Get(this.m_grid), n"ModEntryItem");
      currentModEntry = currentModPanel.GetController() as ModEntryItem;
      currentModEntry.SetID(i);
      currentModEntry.SetOwnerMenu(this.m_ownerMenu);
      currentModEntry.SetWaitingForModDataState();
      ArrayPush(this.m_modEntryItemList, currentModPanel);
      if i == 2 {
        currentModEntry.OverrideNavigation(inkDiscreteNavigationDirection.Up, this.m_ownerMenu.GetModDrawerButtonWidget());
      };
      i += 1;
    };
  }

  public final func SetGridToWaitingForModState() -> Void {
    let currentModEntry: ref<ModEntryItem>;
    let i: Int32 = 0;
    while i < ArraySize(this.m_modEntryItemList) {
      currentModEntry = this.m_modEntryItemList[i].GetController() as ModEntryItem;
      currentModEntry.SetWaitingForModDataState();
      i += 1;
    };
  }

  public final func DestroyGrid(ownerMenu: ref<ModioBrowserMenuGameController>) -> Void {
    let currentModEntry: ref<ModEntryItem>;
    let currentModPanel: ref<inkWidget>;
    let i: Int32 = 0;
    while i < 9 {
      currentModPanel = this.m_modEntryItemList[i];
      currentModEntry = currentModPanel.GetController() as ModEntryItem;
      currentModEntry.UnregisterFromCallback(n"OnRelease", ownerMenu, n"OnModClicked");
      i += 1;
    };
    ArrayClear(this.m_modEntryItemList);
  }

  public final func UpdateGrid(newModList: [ModioModInfos], modProgressInfo: ModioModProgressInfo) -> Void {
    let currentModEntryItem: ref<ModEntryItem>;
    let i: Int32 = 0;
    while i < ArraySize(newModList) && i < 9 {
      this.m_modEntryItemList[i].SetVisible(true);
      currentModEntryItem = this.m_modEntryItemList[i].GetController() as ModEntryItem;
      currentModEntryItem.SetModInfo(newModList[i], modProgressInfo, this.m_ownerMenu.FormatByteSizeToReadableSize(newModList[i].size));
      i += 1;
    };
    i;
    while i < 9 {
      currentModEntryItem = this.m_modEntryItemList[i].GetController() as ModEntryItem;
      currentModEntryItem.SetEmptyDataState();
      i += 1;
    };
  }

  public final func UpdateProgress(modProgressInfo: ModioModProgressInfo, currentlyDisplayedModInfos: [ModioModInfos]) -> Void {
    let currentModEntryItem: ref<ModEntryItem>;
    let i: Int32 = 0;
    while i < 9 && i < ArraySize(this.m_modEntryItemList) {
      currentModEntryItem = this.m_modEntryItemList[i].GetController() as ModEntryItem;
      currentModEntryItem.UpdateProgress(modProgressInfo, currentlyDisplayedModInfos);
      i += 1;
    };
  }

  public final func SetWarningStateOnGrid() -> Void {
    let currentModEntry: ref<ModEntryItem>;
    let currentModPanel: ref<inkWidget>;
    let i: Int32 = 0;
    while i < 9 {
      currentModPanel = this.m_modEntryItemList[i];
      currentModEntry = currentModPanel.GetController() as ModEntryItem;
      currentModEntry.SetWarningDataState();
      i += 1;
    };
  }

  public final func RemoveWarningStateOnGrid() -> Void {
    let currentModEntry: ref<ModEntryItem>;
    let currentModPanel: ref<inkWidget>;
    let i: Int32 = 0;
    while i < 9 {
      currentModPanel = this.m_modEntryItemList[i];
      currentModEntry = currentModPanel.GetController() as ModEntryItem;
      currentModEntry.RemoveWarningDataState();
      i += 1;
    };
  }
}

public class ModEntryItem extends AnimatedListItemController {

  private edit let m_modTitle: inkTextRef;

  private edit let m_modNumberOfDownloadsText: inkTextRef;

  private edit let m_modNumberOfDownloadsIcon: inkImageRef;

  private edit let m_modNumberOfLikesText: inkTextRef;

  private edit let m_modNumberOfLikesIcon: inkImageRef;

  private edit let m_modSizeText: inkTextRef;

  private edit let m_modSizeIcon: inkImageRef;

  private edit let m_entryOutlineImage: inkImageRef;

  private edit let m_hoverHighlightCanvas: inkWidgetRef;

  private edit let m_backgroundColorImage: inkImageRef;

  private edit let m_downloadText: inkTextRef;

  private edit let m_downloadBarFillIcon: inkWidgetRef;

  private edit let m_downloadBarOutlineIcon: inkWidgetRef;

  private edit let m_likedByUserIcon: inkWidgetRef;

  private edit let m_newModWidget: inkWidgetRef;

  private edit let m_modLogoWidget: inkImageRef;

  private edit let m_subscribedToModIcon: inkImageRef;

  private edit let m_logoLoadingWidget: inkWidgetRef;

  private edit let m_logoLoadingSpinner: inkWidgetRef;

  private edit let m_logoLoading_bg: inkImageRef;

  private edit let m_logoErrorWidget: inkImageRef;

  private edit let m_waitingForDataWidget: inkWidgetRef;

  private edit let m_waitingForDataLoadingSpinner: inkWidgetRef;

  private edit let m_emptyDataWidget: inkWidgetRef;

  private edit let m_warningErrorWidget: inkWidgetRef;

  private edit let m_downloadProgressBar: inkCompoundRef;

  private let m_root: wref<inkWidget>;

  private let m_basePreviewSize: Vector2;

  public let m_ID: Int32;

  private let m_colorNames: ModsMenuColorsNames;

  public let m_isUserSubscribedToMod: Bool;

  public let m_isModEntrySelected: Bool;

  private let m_numberOfScreenshotRequests: Int32;

  @default(ModEntryItem, false)
  private let m_isWaitingForData: Bool;

  @default(ModEntryItem, false)
  private let m_isInWarningDataState: Bool;

  @default(ModEntryItem, false)
  private let m_hasNoData: Bool;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private let m_modID: Int64;

  public final func SetOwnerMenu(inOwnerMenu: wref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inOwnerMenu;
    this.m_ownerMenu.AddToListOfNavigables(this);
  }

  public final func SetID(inID: Int32) -> Void {
    this.m_ID = inID;
  }

  public final func ResetData() -> Void {
    this.m_isUserSubscribedToMod = false;
    this.m_isModEntrySelected = false;
    this.m_hasNoData = true;
    this.m_modID = -1l;
  }

  public final func SetModInfo(modInfo: ModioModInfos, modProgressInfo: ModioModProgressInfo, formattedModSizeText: String) -> Void {
    let downloadProgressBarController: ref<ModItemDownloadProgressBarController>;
    this.AdjustCosmeticsForLikesAndDownloads(modInfo);
    inkTextRef.SetText(this.m_modTitle, modInfo.name);
    inkTextRef.SetText(this.m_modSizeText, formattedModSizeText);
    this.m_isUserSubscribedToMod = modInfo.bIsUserSubscribedToMod;
    inkWidgetRef.SetVisible(this.m_subscribedToModIcon, modInfo.bIsUserSubscribedToMod && this.m_ownerMenu.GetIsModInstalled(modInfo.id));
    inkWidgetRef.SetVisible(this.m_likedByUserIcon, modInfo.bIsUserLikingMod);
    inkWidgetRef.SetVisible(this.m_newModWidget, modInfo.bIsModNewForUser);
    this.ApplyUnselectedColor();
    this.RemoveWaitingForModDataState();
    this.RemoveEmptyDataState();
    if modInfo.bIsModEnabledForUser {
      inkImageRef.SetTexturePart(this.m_subscribedToModIcon, n"enabled_rectangle_icon");
      inkWidgetRef.Get(this.m_subscribedToModIcon).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    } else {
      inkImageRef.SetTexturePart(this.m_subscribedToModIcon, n"disabled_rectangle_icon");
      inkWidgetRef.Get(this.m_subscribedToModIcon).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
    };
    downloadProgressBarController = inkWidgetRef.GetController(this.m_downloadProgressBar) as ModItemDownloadProgressBarController;
    if modProgressInfo.modID == modInfo.id {
      downloadProgressBarController.SetGlobalVisibility(true);
      downloadProgressBarController.SetProgress(modProgressInfo.progressRate);
      downloadProgressBarController.SetProgressTextFromProgress(modProgressInfo.progressState);
      inkWidgetRef.SetVisible(this.m_subscribedToModIcon, true);
      inkImageRef.SetTexturePart(this.m_subscribedToModIcon, n"install_rectangle_icon");
      inkWidgetRef.Get(this.m_subscribedToModIcon).BindProperty(n"tintColor", this.m_colorNames.yellowName);
    } else {
      if NotEquals(modInfo.modState, inkModioModState.MAX) {
        downloadProgressBarController.SetGlobalVisibility(true);
        downloadProgressBarController.SetProgressBarVisibility(false);
        downloadProgressBarController.SetProgressTextFromModState(modInfo.modState);
        inkWidgetRef.SetVisible(this.m_subscribedToModIcon, true);
        inkImageRef.SetTexturePart(this.m_subscribedToModIcon, n"install_rectangle_icon");
        inkWidgetRef.Get(this.m_subscribedToModIcon).BindProperty(n"tintColor", this.m_colorNames.yellowName);
      } else {
        downloadProgressBarController.SetGlobalVisibility(false);
      };
    };
    if modInfo.bIsModWaitingEndOfInstallation {
      inkWidgetRef.SetVisible(this.m_subscribedToModIcon, true);
      inkImageRef.SetTexturePart(this.m_subscribedToModIcon, n"install_rectangle_icon");
      inkWidgetRef.Get(this.m_subscribedToModIcon).BindProperty(n"tintColor", this.m_colorNames.yellowName);
    };
    this.m_modID = modInfo.id;
  }

  public final func AdjustCosmeticsForLikesAndDownloads(inModInfo: ModioModInfos) -> Void {
    let cosmeticNumberOfDownloads: Int64;
    let cosmeticNumberOfLikes: Int64;
    if inModInfo.id != 0l {
      cosmeticNumberOfLikes = inModInfo.rating + Cast<Int64>(inModInfo.bIsUserLikingMod ? 1 : 0);
      cosmeticNumberOfDownloads = inModInfo.downloadsTotal + this.m_ownerMenu.GetLocalNumberOfDownloadsForMod(inModInfo.id);
      inkTextRef.SetText(this.m_modNumberOfLikesText, ToString(cosmeticNumberOfLikes));
      inkTextRef.SetText(this.m_modNumberOfDownloadsText, ToString(cosmeticNumberOfDownloads));
    };
  }

  public final func UpdateProgress(modProgressInfo: ModioModProgressInfo, currentlyDisplayedModInfos: [ModioModInfos]) -> Void {
    let i: Int32;
    let downloadProgressBarController: ref<ModItemDownloadProgressBarController> = inkWidgetRef.GetController(this.m_downloadProgressBar) as ModItemDownloadProgressBarController;
    let bFound: Bool = false;
    if modProgressInfo.modID == this.m_modID && this.m_modID != -1l {
      downloadProgressBarController.SetGlobalVisibility(true);
      downloadProgressBarController.SetProgress(modProgressInfo.progressRate);
      downloadProgressBarController.SetProgressTextFromProgress(modProgressInfo.progressState);
      bFound = true;
    } else {
      i = 0;
      while i < ArraySize(currentlyDisplayedModInfos) {
        if currentlyDisplayedModInfos[i].id == this.m_modID {
          if NotEquals(currentlyDisplayedModInfos[i].modState, inkModioModState.MAX) {
            bFound = true;
            downloadProgressBarController.SetGlobalVisibility(true);
            downloadProgressBarController.SetProgressBarVisibility(false);
            downloadProgressBarController.SetProgressTextFromModState(currentlyDisplayedModInfos[i].modState);
            break;
          };
        };
        i += 1;
      };
    };
    if !bFound {
      downloadProgressBarController.SetGlobalVisibility(false);
    };
  }

  protected cb func OnInitialize() -> Bool {
    this.m_root = this.GetRootWidget();
    this.m_basePreviewSize = inkWidgetRef.GetSize(this.m_modLogoWidget);
    this.m_numberOfScreenshotRequests = 0;
    this.ResetData();
    this.ShowLogoLoadingIcon();
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    this.ApplyDefaultColor();
    super.OnInitialize();
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    super.OnUninitialize();
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    let bIsLanguageDropdownOpened: Bool;
    let bIsSortingDropdownOpened: Bool;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    this.m_ownerMenu.UpdateCurrentlyHoveredMod(this.m_ID);
    bIsSortingDropdownOpened = this.m_ownerMenu.m_sortingDropdownListController.IsOpened();
    bIsLanguageDropdownOpened = this.m_ownerMenu.m_languageDropdownListController.IsOpened();
    if !bIsSortingDropdownOpened && !bIsLanguageDropdownOpened {
      inkWidgetRef.SetVisible(this.m_hoverHighlightCanvas, true);
    };
    this.m_ownerMenu.RequestButtonHintUpdateNextFrame();
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    let bIsLanguageDropdownOpened: Bool;
    let bIsSortingDropdownOpened: Bool;
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    this.m_ownerMenu.UpdateCurrentlyHoveredMod(-1);
    bIsSortingDropdownOpened = this.m_ownerMenu.m_sortingDropdownListController.IsOpened();
    bIsLanguageDropdownOpened = this.m_ownerMenu.m_languageDropdownListController.IsOpened();
    if !bIsSortingDropdownOpened && !bIsLanguageDropdownOpened {
      inkWidgetRef.SetVisible(this.m_hoverHighlightCanvas, false);
    };
    this.m_ownerMenu.RequestButtonHintUpdateNextFrame();
  }

  protected cb func OnRelease(e: ref<inkPointerEvent>) -> Bool {
    if e.IsAction(n"click") || e.IsAction(n"tap") {
    };
  }

  private final func ShouldNotListenBackToClick() -> Bool {
    return this.m_hasNoData || this.m_isInWarningDataState || this.m_isWaitingForData;
  }

  public final func SetWaitingForModDataState() -> Void {
    let spinLoadingController: ref<LoadingScreenProgressBarController>;
    inkWidgetRef.SetVisible(this.m_waitingForDataWidget, true);
    spinLoadingController = inkWidgetRef.GetController(this.m_waitingForDataLoadingSpinner) as LoadingScreenProgressBarController;
    spinLoadingController.SetSpinnerVisibility(true);
    this.m_isWaitingForData = true;
    this.ApplyDefaultColor();
    this.UnregisterFromCallback(n"OnRelease", this.m_ownerMenu, n"OnModClicked");
  }

  public final func RemoveWaitingForModDataState() -> Void {
    let spinLoadingController: ref<LoadingScreenProgressBarController>;
    inkWidgetRef.SetVisible(this.m_waitingForDataWidget, false);
    spinLoadingController = inkWidgetRef.GetController(this.m_waitingForDataLoadingSpinner) as LoadingScreenProgressBarController;
    spinLoadingController.SetSpinnerVisibility(false);
    this.m_isWaitingForData = false;
  }

  public final func SetEmptyDataState() -> Void {
    this.RemoveWaitingForModDataState();
    inkWidgetRef.SetVisible(this.m_emptyDataWidget, true);
    this.UnregisterFromCallback(n"OnRelease", this.m_ownerMenu, n"OnModClicked");
    this.ResetData();
    this.ApplyUnselectedColor();
  }

  public final func RemoveEmptyDataState() -> Void {
    inkWidgetRef.SetVisible(this.m_emptyDataWidget, false);
    this.m_hasNoData = false;
    if !this.ShouldNotListenBackToClick() {
      this.RegisterToCallback(n"OnRelease", this.m_ownerMenu, n"OnModClicked");
    };
  }

  public final func SetWarningDataState() -> Void {
    this.RemoveWaitingForModDataState();
    inkWidgetRef.SetVisible(this.m_warningErrorWidget, true);
    this.UnregisterFromCallback(n"OnRelease", this.m_ownerMenu, n"OnModClicked");
    this.ApplyUnselectedColor();
    this.m_isInWarningDataState = true;
  }

  public final func RemoveWarningDataState() -> Void {
    inkWidgetRef.SetVisible(this.m_warningErrorWidget, false);
    this.m_isInWarningDataState = false;
    if !this.ShouldNotListenBackToClick() {
      this.RegisterToCallback(n"OnRelease", this.m_ownerMenu, n"OnModClicked");
    };
  }

  private final func ApplyDefaultColor() -> Void {
    this.ApplyColorToItem(this.m_colorNames.activeRedName);
    inkWidgetRef.Get(this.m_entryOutlineImage).BindProperty(n"tintColor", this.m_colorNames.darkerRedName);
    this.ApplyColorToBackground(this.m_colorNames.fullscreenRedDarkBackgroundName);
  }

  private final func ApplySubscribedColor() -> Void {
    this.ApplyColorToItem(this.m_colorNames.yellowName);
    inkWidgetRef.Get(this.m_entryOutlineImage).BindProperty(n"tintColor", this.m_colorNames.mildYellowName);
    this.ApplyColorToBackground(this.m_colorNames.panelDarkYellowName);
  }

  public final func ApplyUnselectedColor() -> Void {
    if this.m_isUserSubscribedToMod {
      this.ApplySubscribedColor();
    } else {
      this.ApplyDefaultColor();
    };
  }

  public final func ApplySelectedColor() -> Void {
    this.ApplyColorToItem(this.m_colorNames.activeBlueName);
    this.ApplyColorToBackground(this.m_colorNames.fullscreenPrimaryBackgroundDarkName);
  }

  private final func ApplyColorToItem(colorNameToApply: CName) -> Void {
    inkWidgetRef.Get(this.m_modTitle).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_modNumberOfDownloadsText).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_modNumberOfDownloadsIcon).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_modNumberOfLikesText).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_modNumberOfLikesIcon).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_modSizeText).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_modSizeIcon).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_entryOutlineImage).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_hoverHighlightCanvas).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_downloadText).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_downloadBarFillIcon).BindProperty(n"tintColor", colorNameToApply);
    inkWidgetRef.Get(this.m_downloadBarOutlineIcon).BindProperty(n"tintColor", colorNameToApply);
  }

  private final func ApplyColorToBackground(colorNameToApply: CName) -> Void {
    inkWidgetRef.Get(this.m_backgroundColorImage).BindProperty(n"tintColor", colorNameToApply);
  }

  public final func RemoveNewModIcon() -> Void {
    inkWidgetRef.SetVisible(this.m_newModWidget, false);
  }

  public final func HandleScreenshotRequest() -> Void {
    this.m_numberOfScreenshotRequests = this.m_numberOfScreenshotRequests + 1;
    this.ShowLogoLoadingIcon();
  }

  protected cb func OnScreenshotLoadedByPath(screenshotSize: Vector2, errorCode: Int32) -> Bool {
    this.m_numberOfScreenshotRequests = this.m_numberOfScreenshotRequests > 0 ? this.m_numberOfScreenshotRequests - 1 : 0;
    if errorCode == 0 && this.m_numberOfScreenshotRequests == 0 {
      this.ShowLogoImage();
    } else {
      if errorCode != 0 {
        this.ShowLogoErrorIcon();
      };
    };
  }

  public final func GetLogoWidget() -> ref<inkImage> {
    return inkWidgetRef.Get(this.m_modLogoWidget) as inkImage;
  }

  public final func ShowLogoImage() -> Void {
    let spinLoadingController: ref<LoadingScreenProgressBarController>;
    inkWidgetRef.SetVisible(this.m_logoLoadingWidget, false);
    inkWidgetRef.SetVisible(this.m_logoLoadingSpinner, false);
    spinLoadingController = inkWidgetRef.GetController(this.m_logoLoadingSpinner) as LoadingScreenProgressBarController;
    spinLoadingController.SetSpinnerVisibility(false);
    inkWidgetRef.SetVisible(this.m_logoLoading_bg, false);
    inkWidgetRef.SetVisible(this.m_modLogoWidget, true);
    inkWidgetRef.SetVisible(this.m_logoErrorWidget, false);
  }

  public final func ShowLogoLoadingIcon() -> Void {
    let spinLoadingController: ref<LoadingScreenProgressBarController>;
    inkWidgetRef.SetVisible(this.m_logoLoadingWidget, true);
    inkWidgetRef.SetVisible(this.m_logoLoadingSpinner, true);
    spinLoadingController = inkWidgetRef.GetController(this.m_logoLoadingSpinner) as LoadingScreenProgressBarController;
    spinLoadingController.SetSpinnerVisibility(true);
    inkWidgetRef.SetVisible(this.m_logoLoading_bg, true);
    inkWidgetRef.SetVisible(this.m_modLogoWidget, false);
    inkWidgetRef.SetVisible(this.m_logoErrorWidget, false);
  }

  public final func ShowLogoErrorIcon() -> Void {
    let spinLoadingController: ref<LoadingScreenProgressBarController>;
    inkWidgetRef.SetVisible(this.m_logoLoadingWidget, false);
    inkWidgetRef.SetVisible(this.m_logoLoadingSpinner, false);
    spinLoadingController = inkWidgetRef.GetController(this.m_logoLoadingSpinner) as LoadingScreenProgressBarController;
    spinLoadingController.SetSpinnerVisibility(true);
    inkWidgetRef.SetVisible(this.m_logoLoading_bg, false);
    inkWidgetRef.SetVisible(this.m_modLogoWidget, false);
    inkWidgetRef.SetVisible(this.m_logoErrorWidget, true);
  }
}

public class filterModsMenuModPicker extends inkLogicController {

  private edit let m_filterIconList: inkHorizontalPanelRef;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  public final func DisplayFilters(inOwnerMenu: ref<BrowserModsMenuGameController>) -> Void {
    let currentFilterIcon: ref<inkWidget>;
    let currentFilterIconController: ref<FilterIconItem>;
    this.m_ownerMenu = inOwnerMenu;
    let i: Int32 = 0;
    while i < 9 {
      currentFilterIcon = this.SpawnFromLocal(inkWidgetRef.Get(this.m_filterIconList), n"FilterIconItem");
      currentFilterIconController = currentFilterIcon.GetController() as FilterIconItem;
      currentFilterIconController.SetupFilterItem(IntEnum<inkModioFilterTags>(i), this.m_ownerMenu);
      currentFilterIconController.RegisterToCallback(n"OnHoverOver", this.m_ownerMenu, n"OnFilterHoverOver");
      currentFilterIconController.RegisterToCallback(n"OnHoverOut", this.m_ownerMenu, n"OnFilterHoverOut");
      i += 1;
    };
  }
}

public class FilterIconItem extends AnimatedListItemController {

  private edit let m_iconImage: inkImageRef;

  private edit let m_fluffText: inkTextRef;

  private edit let m_frameImage: inkImageRef;

  private edit let m_backgroundImage: inkImageRef;

  private edit let m_tooltipSnapPoint: inkCompoundRef;

  private let m_isSelected: Bool;

  private let m_filterTag: inkModioFilterTags;

  private let m_filterTagName: String;

  private let m_currentTexturePart: CName;

  private let m_colorNames: ModsMenuColorsNames;

  private let m_tooltipWidget: wref<inkWidget>;

  private let m_tooltipController: wref<ModioToolTipController>;

  private let m_ownerMenu: wref<BrowserModsMenuGameController>;

  private final func GetTexturePartFromFilterTag(inTexturePart: inkModioFilterTags) -> CName {
    let texturePart: CName;
    switch inTexturePart {
      case inkModioFilterTags.Appearance:
        texturePart = n"Clothes";
        break;
      case inkModioFilterTags.Characters:
        texturePart = n"Person";
        break;
      case inkModioFilterTags.Weapons:
        texturePart = n"Gun";
        break;
      case inkModioFilterTags.Vehicles:
        texturePart = n"Motorbike";
        break;
      case inkModioFilterTags.Animations:
        texturePart = n"Objects";
        break;
      case inkModioFilterTags.Gameplay:
        texturePart = n"Gamepad";
        break;
      case inkModioFilterTags.Graphics:
        texturePart = n"Photo";
        break;
      case inkModioFilterTags.Audio:
        texturePart = n"Sound";
        break;
      case inkModioFilterTags.Misc:
        texturePart = n"all";
        break;
      default:
        texturePart = n"Warning";
    };
    return texturePart;
  }

  protected cb func OnInitialize() -> Bool {
    this.m_isSelected = false;
    this.SetUnselectedColor();
    this.RegisterToCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.RegisterToCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.RegisterToCallback(n"OnRelease", this, n"OnRelease");
    super.OnInitialize();
  }

  protected cb func OnUninitialize() -> Bool {
    this.UnregisterFromCallback(n"OnHoverOver", this, n"OnHoverOver");
    this.UnregisterFromCallback(n"OnHoverOut", this, n"OnHoverOut");
    this.UnregisterFromCallback(n"OnRelease", this, n"OnRelease");
    super.OnUninitialize();
  }

  protected cb func OnHoverOver(e: ref<inkPointerEvent>) -> Bool {
    if !this.m_isSelected && !this.m_ownerMenu.ShouldIgnoreInput() {
      inkWidgetRef.Get(this.m_frameImage).BindProperty(n"tintColor", this.m_colorNames.redName);
    };
  }

  protected cb func OnHoverOut(e: ref<inkPointerEvent>) -> Bool {
    if this.m_ownerMenu.ShouldIgnoreInput() {
      return true;
    };
    if this.m_isSelected {
      this.SetSelectedColor();
    } else {
      this.SetUnselectedColor();
    };
  }

  protected cb func OnRelease(e: ref<inkPointerEvent>) -> Bool {
    if e.IsAction(n"click") || e.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      this.m_isSelected = !this.m_isSelected;
      if !this.m_isSelected {
        this.SetUnselectedColor();
      } else {
        this.SetSelectedColor();
      };
      this.m_ownerMenu.UpdateCurrentlySelectedFilters(this.m_filterTag);
    };
  }

  private final func SetSelectedColor() -> Void {
    inkWidgetRef.Get(this.m_iconImage).BindProperty(n"tintColor", this.m_colorNames.activeBlueName);
    inkWidgetRef.Get(this.m_frameImage).BindProperty(n"tintColor", this.m_colorNames.darkBlueName);
    inkWidgetRef.Get(this.m_fluffText).BindProperty(n"tintColor", this.m_colorNames.darkBlueName);
    inkWidgetRef.Get(this.m_backgroundImage).BindProperty(n"tintColor", this.m_colorNames.faintBlueName);
  }

  private final func SetUnselectedColor() -> Void {
    inkWidgetRef.Get(this.m_iconImage).BindProperty(n"tintColor", this.m_colorNames.activeRedName);
    inkWidgetRef.Get(this.m_frameImage).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_fluffText).BindProperty(n"tintColor", this.m_colorNames.mildRedName);
    inkWidgetRef.Get(this.m_backgroundImage).BindProperty(n"tintColor", this.m_colorNames.fullscreenRedDarkBackgroundName);
  }

  public final func SetupFilterItem(inFilterTag: inkModioFilterTags, inOwnerMenu: ref<BrowserModsMenuGameController>) -> Void {
    this.m_ownerMenu = inOwnerMenu;
    this.m_filterTag = inFilterTag;
    this.m_filterTagName = this.m_ownerMenu.GetFilterTagNameFromEnum(this.m_filterTag);
    inkImageRef.SetTexturePart(this.m_iconImage, this.GetTexturePartFromFilterTag(inFilterTag));
    this.m_ownerMenu.AddToListOfNavigables(this);
  }

  public final func GetFilterName() -> String {
    return this.m_filterTagName;
  }

  public final func GetLocalizedFilterKey() -> String {
    let resultString: String;
    switch this.m_filterTag {
      case inkModioFilterTags.Appearance:
        resultString = "UI-Modio-FiltersSorting-Appearance";
        break;
      case inkModioFilterTags.Characters:
        resultString = "UI-Modio-FiltersSorting-Characters";
        break;
      case inkModioFilterTags.Weapons:
        resultString = "UI-Modio-FiltersSorting-Weapons";
        break;
      case inkModioFilterTags.Vehicles:
        resultString = "UI-Modio-FiltersSorting-Vehicles";
        break;
      case inkModioFilterTags.Animations:
        resultString = "UI-Modio-FiltersSorting-Animations";
        break;
      case inkModioFilterTags.Gameplay:
        resultString = "UI-Modio-FiltersSorting-Gameplay";
        break;
      case inkModioFilterTags.Graphics:
        resultString = "UI-Modio-FiltersSorting-Graphics";
        break;
      case inkModioFilterTags.Audio:
        resultString = "UI-Modio-FiltersSorting-Audio";
        break;
      case inkModioFilterTags.Misc:
        resultString = "UI-Modio-FiltersSorting-Misc";
        break;
      default:
        resultString = "Error";
    };
    return resultString;
  }
}

public class ModDetailsItem extends inkLogicController {

  public edit let m_modName: inkTextRef;

