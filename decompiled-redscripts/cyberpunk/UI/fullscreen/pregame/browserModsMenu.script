public class LanguageDropdownCheckboxListController extends DropdownListController {

  public let m_languageItems: [wref<LanguageDropdownCheckboxElementController>];

  protected func SetupData(const data: script_ref<[ref<DropdownItemData>]>) -> Void {
    let i: Int32;
    let item: ref<LanguageDropdownCheckboxElementController>;
    let languageCheckbox: ref<LanguageCheckbox>;
    this.m_data = Deref(data);
    inkCompoundRef.RemoveAllChildren(this.m_listContainer);
    i = 0;
    while i < ArraySize(Deref(data)) {
      item = this.SpawnFromLocal(inkWidgetRef.Get(this.m_listContainer), n"LanguagesDropdownCheckboxElement").GetController() as LanguageDropdownCheckboxElementController;
      item.m_ownerMenu = this.m_ownerController as BrowserModsMenuGameController;
      item.Setup(Deref(data)[i]);
      item.m_ownerMenu.AddToListOfNavigables(item);
      languageCheckbox = item.m_languageCheckboxController;
      languageCheckbox.InitializeCheckbox(this.m_ownerController as BrowserModsMenuGameController, FromVariant<inkModioLanguageTagsOptions>(Deref(data)[i].identifier));
      ArrayPush(this.m_languageItems, item);
      if i == 0 {
        item.SetActive(true);
        this.m_activeElement = item;
      };
      i += 1;
    };
  }
}

