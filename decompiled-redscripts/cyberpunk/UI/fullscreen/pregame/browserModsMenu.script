  public let m_languageDropdownCheckboxListController: wref<LanguageDropdownCheckboxListController>;

  public let m_languageDropdownListController: wref<LanguageDropdownListController>;

  private let m_languageDropdownButtonController: wref<LanguageDropdownButtonController>;

  private let m_modPickerController: wref<browserModsMenuModPicker>;

