  protected cb func OnLanguageButtonClicked(evt: ref<inkPointerEvent>) -> Bool {
    if evt.IsAction(n"click") || evt.IsAction(n"tap") {
      this.PlaySound(n"Button", n"OnPress");
      this.m_languageDropdownListController.Toggle();
    };
  }

  protected cb func OnDropdownItemClickedEvent(evt: ref<DropdownItemClickedEvent>) -> Bool {
    let identifierTypeName: CName;
    let languageButtonController: ref<LanguageDropdownButtonController>;
    let languageData: ref<DropdownItemData>;
    let languageIdentifier: inkModioLanguageTagsOptions;
    let sortingButtonController: ref<ModSortingDropdownButtonController>;
    let sortingData: ref<DropdownItemData>;
    let sortingIdentifier: inkModioModSortingOptions;
    this.PlaySound(n"Button", n"OnPress");
    identifierTypeName = VariantTypeName(evt.identifier);
    if Equals(identifierTypeName, n"inkModioModSortingOptions") {
      sortingIdentifier = FromVariant<inkModioModSortingOptions>(evt.identifier);
      sortingData = ModSortingDropdownData.GetSortingDropdownOption(this.m_sortingDropdownListController.GetData(), sortingIdentifier);
      if IsDefined(sortingData) {
        sortingButtonController = this.m_sortingDropdownButtonController.GetController() as ModSortingDropdownButtonController;
        sortingButtonController.SetData(sortingData);
        this.UpdateCurrentlySelectedSortingOptions(sortingIdentifier);
        if this.IsUsingDPad() {
          this.SetCursorOverWidget(this.m_sortingDropdownListController.GetRootWidget(), 0.00, true);
        } else {
          this.ResetCursor();
        };
      };
    } else {
      if Equals(identifierTypeName, n"inkModioLanguageTagsOptions") {
        languageIdentifier = FromVariant<inkModioLanguageTagsOptions>(evt.identifier);
        languageData = ModLanguageDropdownData.GetLanguageDropdownOption(this.m_languageDropdownListController.GetData(), languageIdentifier);
        if IsDefined(languageData) {
          languageButtonController = this.m_languageDropdownButtonController.GetController() as LanguageDropdownButtonController;
          languageButtonController.SetData(languageData);
          this.UpdateCurrentlySelectedLanguageTags(languageIdentifier);
        };
      };
    };
  }

