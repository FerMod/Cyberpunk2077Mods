  protected cb func OnAllLanguagesCheckboxClicked(bNewState: Bool, bUpdateAllCheckboxes: Bool) -> Bool {
    let checkBoxController: ref<LanguageCheckbox>;
    let item: ref<LanguageDropdownCheckboxElementController>;
    let languageDropdown: ref<LanguageDropdownCheckboxListController> = this.m_languageDropdownCheckboxListController;
    let i: Int32 = 0;
    while i < ArraySize(languageDropdown.m_languageItems) {
      item = languageDropdown.m_languageItems[i];
      if i == 0 || bUpdateAllCheckboxes {
        checkBoxController = item.m_languageCheckboxController;
        checkBoxController.UpdateCheckbox(bNewState);
      };
      i += 1;
    };
  }

