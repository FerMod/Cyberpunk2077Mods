  @runtimeProperty("category", "Gog")
  private edit let m_gogContainerRef: inkCompoundRef;

  @runtimeProperty("category", "Gog")
  private edit let m_gogUserDisplayContainerRef: inkWidgetRef;

  @runtimeProperty("category", "Buttons")
  private edit let m_AdditionalButtonsBoxRef: inkCompoundRef;

  @runtimeProperty("category", "Buttons")
  private edit let m_accountSelector: inkCompoundRef;

  @runtimeProperty("category", "Buttons")
