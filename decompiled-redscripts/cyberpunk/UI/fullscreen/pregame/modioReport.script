
public class ModioReportController extends inkLogicController {

  private edit let m_reportTypeBtnRef1: inkWidgetRef;

  private edit let m_reportTypeBtnRef2: inkWidgetRef;

  private edit let m_reportTypeBtnRef3: inkWidgetRef;

  private edit let m_reportTypeBtnRef4: inkWidgetRef;

  private edit let m_reportTypeBtnRef5: inkWidgetRef;

  private edit let m_reportTypeBtnRef6: inkWidgetRef;

  private edit let m_reportTypeBtnRef7: inkWidgetRef;

  private edit let m_reportPanel1: inkWidgetRef;

  private edit let m_reportPanel2: inkWidgetRef;

  private edit let m_reportTypeBtnInStep2Ref: inkWidgetRef;

  private edit let m_reportTypeLabelInStep2Ref: inkTextRef;

  private edit let m_titleMsgRef: inkTextRef;

  private edit let m_hyperlinkButtonRef1: inkWidgetRef;

  private edit let m_hyperlinkButtonRef2: inkWidgetRef;

  private edit let m_agreeBtnRef: inkWidgetRef;

  private edit let m_NoThanksBtnRef: inkWidgetRef;

  private edit let m_detailText: inkTextInputRef;

  private edit let m_detailArea: inkWidgetRef;

  private edit let m_SelectModLabelRef: inkTextRef;

  private edit let m_SelectModImg: inkImageRef;

  private edit let m_detailTextArea: inkWidgetRef;

  private let m_fadeAnim: ref<inkAnimProxy>;

  private let m_currentModID: Int64;

