public class MenuScenario_Pitch extends MenuScenario_PreGameSubMenu {

  private let m_fallbackScenario: CName;

  protected cb func OnEnterScenario(prevScenario: CName, userData: ref<IScriptable>) -> Bool {
    let menuState: wref<inkMenusState>;
    super.OnEnterScenario(prevScenario, userData);
    if Equals(prevScenario, n"MenuScenario_SingleplayerMenu") || Equals(prevScenario, n"MenuScenario_LoadGame") {
      this.m_fallbackScenario = prevScenario;
    } else {
      this.m_fallbackScenario = n"MenuScenario_SingleplayerMenu";
    };
    menuState = this.GetMenusState();
    menuState.OpenMenu(n"pitch_menu");
  }

  protected cb func OnLeaveScenario(nextScenario: CName) -> Bool {
    super.OnLeaveScenario(nextScenario);
    this.GetMenusState().CloseMenu(n"pitch_menu");
  }

  protected cb func OnSwitchToTelemetryScreen() -> Bool {
    this.CloseSubMenu();
    this.SwitchToScenario(n"MenuScenario_Telemetry");
  }

  protected cb func OnMainMenuBack() -> Bool {
    this.CloseSubMenu();
    this.SwitchToScenario(n"MenuScenario_SingleplayerMenu");
  }

  protected cb func OnMainMenu() -> Bool {
    let requestsHandler: wref<inkISystemRequestsHandler> = this.GetSystemRequestsHandler();
    let patchNotesCheckData: ref<PatchNotesCheckData> = new PatchNotesCheckData();
    patchNotesCheckData.m_ownExpansion = requestsHandler.IsAdditionalContentEnabled(n"EP1");
    let menuState: wref<inkMenusState> = this.GetMenusState();
    this.SwitchToScenario(this.m_fallbackScenario);
    menuState.DispatchEvent(n"singleplayer_menu", n"OnCheckPatchNotes", patchNotesCheckData);
  }
}

public class MenuScenario_Telemetry extends MenuScenario_PreGameSubMenu {

  protected cb func OnEnterScenario(prevScenario: CName, userData: ref<IScriptable>) -> Bool {
    let menuState: wref<inkMenusState>;
    super.OnEnterScenario(prevScenario, userData);
    menuState = this.GetMenusState();
    menuState.OpenMenu(n"pitch_telemetry_menu");
  }

  protected cb func OnLeaveScenario(nextScenario: CName) -> Bool {
    this.GetMenusState().CloseMenu(n"pitch_telemetry_menu");
  }

  protected cb func OnMainMenu() -> Bool {
    let requestsHandler: wref<inkISystemRequestsHandler> = this.GetSystemRequestsHandler();
    let patchNotesCheckData: ref<PatchNotesCheckData> = new PatchNotesCheckData();
    patchNotesCheckData.m_ownExpansion = requestsHandler.IsAdditionalContentEnabled(n"EP1");
    let menuState: wref<inkMenusState> = this.GetMenusState();
    this.SwitchToScenario(n"MenuScenario_SingleplayerMenu");
    menuState.DispatchEvent(n"singleplayer_menu", n"OnCheckPatchNotes", patchNotesCheckData);
  }
}
