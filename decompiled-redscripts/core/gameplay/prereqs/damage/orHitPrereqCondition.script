
public class ORHitPrereqCondition extends BaseHitPrereqCondition {

  public let m_conditions: [ref<BaseHitPrereqCondition>];

  public func SetData(recordID: TweakDBID) -> Void {
    let condition: ref<BaseHitPrereqCondition>;
    let conds: array<TweakDBID>;
    let i: Int32;
    ArrayClear(this.m_conditions);
    conds = TweakDBInterface.GetForeignKeyArray(recordID + t".conditions");
    i = 0;
    while i < ArraySize(conds) {
      condition = GenericHitPrereq.CreateHitCondition(TweakDBInterface.GetHitPrereqConditionRecord(conds[i]));
      if IsDefined(condition) {
        ArrayPush(this.m_conditions, condition);
      };
      i += 1;
    };
  }

  public func Evaluate(hitEvent: ref<gameHitEvent>) -> Bool {
    let result: Bool = false;
    let i: Int32 = 0;
    while i < ArraySize(this.m_conditions) {
      result = this.m_conditions[i].Evaluate(hitEvent);
      if result {
        result = this.CheckOnlyOncePerShot(hitEvent);
        break;
      };
      i += 1;
    };
    return this.m_invert ? !result : result;
  }
}
